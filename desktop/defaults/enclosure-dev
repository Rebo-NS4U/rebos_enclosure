#!/usr/bin/env python3
"""Open the development menu from a persistent Enclosure checkout."""
import os
from pathlib import Path
import subprocess
import sys

home = Path.home()
candidates = []
if os.environ.get('ENCLOSURE_SOURCE'):
    candidates.append(Path(os.environ['ENCLOSURE_SOURCE']).expanduser())
shell = home / '.config/quickshell'
if shell.is_symlink():
    candidates.extend(shell.resolve().parents)
candidates += [home / 'code/rebos_enclosure']
for root in candidates:
    entry = root / 'dev.sh'
    if not entry.is_file() or not (root / '.git').exists():
        continue
    result = subprocess.run(['git', '-C', str(root), 'remote', 'get-url', 'origin'],
                            capture_output=True, text=True)
    origin = result.stdout.strip().rstrip('/').removesuffix('.git')
    if result.returncode == 0 and origin in {
            'https://github.com/Rebo-NS4U/rebos_enclosure',
            'git@github.com:Rebo-NS4U/rebos_enclosure'}:
        os.execv('/usr/bin/bash', ['bash', str(entry), *sys.argv[1:]])
sys.exit('Enclosure source not found. Clone the official repository into ~/code/rebos_enclosure, '
         'or set ENCLOSURE_SOURCE to your checkout, then run enclosure-dev again.')
