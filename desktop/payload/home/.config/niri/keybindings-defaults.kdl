// H/J/K/L = left/down/up/right. Personal overrides belong in keybindings-personal.kdl.
binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name

    // rebos_shell QuickShell actions.
    Mod+Alt+F hotkey-overlay-title="File Shelf" { spawn "qs" "ipc" "call" "rebos_shell" "run" "file-shelf"; }
    Mod+Space hotkey-overlay-title="Open App Launcher" { spawn "qs" "ipc" "call" "rebos_shell" "run" "launcher"; }
    Mod+Alt+N hotkey-overlay-title="Quick Notes" { spawn "qs" "ipc" "call" "rebos_shell" "run" "notes"; }
    Mod+N hotkey-overlay-title="Open Dashboard" { spawn "qs" "ipc" "call" "rebos_shell" "run" "system-monitor"; }
    Mod+V hotkey-overlay-title="Open Clipboard History" { spawn "rebos-clipboard"; }
    Mod+Period hotkey-overlay-title="Open App Launcher" { spawn "qs" "ipc" "call" "rebos_shell" "run" "launcher"; }
    Mod+C hotkey-overlay-title="Open Project" { spawn "qs" "ipc" "call" "rebos_shell" "run" "projects"; }
    Mod+Shift+C hotkey-overlay-title="Open Zed Project" { spawn "project-picker"; }
    Mod+A repeat=false hotkey-overlay-title="Toggle AI Assistant" { spawn "@HOME@/.local/bin/rebos-assistant"; }
    Mod+Shift+A repeat=false hotkey-overlay-title="Open Anime Streamer" { spawn "@HOME@/.local/bin/anime-streamer"; }

    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "kitty"; }
    Mod+W repeat=false hotkey-overlay-title="Open a Web Browser" { spawn "zen-browser"; }
    // Keypad 1/2 are reported as KP_End/KP_Down when Num Lock is off.
    Mod+KP_1 hotkey-overlay-title="Open ChatGPT" { spawn ".config/scripts/browser-app" "https://chatgpt.com/"; }
    Mod+KP_End hotkey-overlay-title="Open ChatGPT" { spawn ".config/scripts/browser-app" "https://chatgpt.com/"; }
    Mod+KP_2 hotkey-overlay-title="Open WhatsApp" { spawn ".config/scripts/browser-app" "https://web.whatsapp.com/"; }
    Mod+KP_Down hotkey-overlay-title="Open WhatsApp" { spawn ".config/scripts/browser-app" "https://web.whatsapp.com/"; }
    Mod+E hotkey-overlay-title="Open a File Manager" { spawn "thunar"; }
    Mod+M hotkey-overlay-title="Open Cider" { spawn "spotify-launcher"; }
    Mod+X hotkey-overlay-title="Open the Power Menu" { spawn "qs" "ipc" "call" "rebos_shell" "run" "powermenu"; }
    Mod+I hotkey-overlay-title="Install a program" {spawn "kitty" "--class" "floating" ".config/scripts/install.sh"; }
    Mod+O hotkey-overlay-title="Install a program (aur)"{spawn "kitty" "--class" "floating" ".config/scripts/install-aur.sh"; }
    Mod+U hotkey-overlay-title="Uninstall a program "{spawn "kitty" "--class" "floating" ".config/scripts/uninstall.sh"; }
    Mod+P hotkey-overlay-title="Port Manager" {spawn "kitty" "--class" "port" ".config/scripts/port-manager.sh";}
    Mod+Alt+L hotkey-overlay-title="Lock Desktop" { spawn "qs" "ipc" "call" "lockscreen" "lock"; }
    Mod+Z hotkey-overlay-title="Refresh app colors" { spawn "qs" "ipc" "call" "theme" "sync"; }
    // Mod+Space hotkey-overlay-title="Transcribe Audio" { spawn "sh" ".config/scripts/whisper-transcribe.sh"; }
    // Alt+Space hotkey-overlay-title="Cloud Transcribe" { spawn "sh" ".config/scripts/whisper-cloud.sh"; }

    // Route media keys through rebos_shell so its OSD stays in sync.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "increment"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "decrement"; }
    XF86AudioMute         allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "toggleMute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "toggleMicMute"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "ipc" "call" "brightness" "decrement"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "ipc" "call" "brightness" "increment"; }

    Mod+Tab repeat=false { toggle-overview; }

    Mod+Shift+W hotkey-overlay-title="Open Wallpapers" { spawn "qs" "ipc" "call" "rebos_shell" "run" "wallpapers"; }
    Mod+Alt+Left repeat=false hotkey-overlay-title="Previous wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "previous"; }
    Mod+Alt+Right repeat=false hotkey-overlay-title="Next wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "next"; }
    Mod+Alt+W repeat=false hotkey-overlay-title="Random wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "random"; }
    Mod+Shift+N hotkey-overlay-title="New Window Rule" { spawn "qs" "ipc" "call" "rebos_shell" "run" "new-window-rule"; }

    Mod+Q { close-window; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { consume-or-expel-window-right; }


    Mod+Shift+Ctrl+H { move-window-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-window-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-window-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-window-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Shift+Page_Down { spawn "sh" "-c" ".config/scripts/scale-adjust.sh -0.05"; }
    Shift+Page_Up   { spawn "sh" "-c" ".config/scripts/scale-adjust.sh +0.05"; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Switch to numbered workspaces directly with Mod+Number.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    // Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    // Mod+Shift+5 { move-column-to-workspace 5; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+G      { toggle-window-floating; }
    Mod+Shift+G { switch-focus-between-floating-and-tiling; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    // Capture the complete layout at native output scale and copy it as PNG.
    Mod+Shift+Print hotkey-overlay-title=null { spawn-sh "grim - | wl-copy --type image/png"; }
    Mod+Print hotkey-overlay-title="Copy Latest Screenshot Path" { spawn ".config/scripts/copy-latest-screenshot-path.sh"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }

    Mod+Shift+P { power-off-monitors; }
}
