input {
    // Avoid re-suspending on firmware power-button events during wake.
    // Paired with /etc/systemd/logind.conf.d/90-lid-wake.conf.
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        // off
        tap
        dwt
        dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        accel-speed 0
        accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // middle-emulation
    }

    //warp-mouse-to-focus
    focus-follows-mouse
}



layout {
    gaps 4
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
    focus-ring {
        off
        inactive-color "#505050"
    }
    border {
        on
        width 1
    }
    shadow {
        on
        softness 50
        spread 12
        offset x=0 y=8
        color "#00000060"
    }
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}


environment {
    XDG_MENU_PREFIX "arch-"
    PATH "@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
}

// Render Wallpaper Engine's "Wallpaper Pop-out" X11 window directly as a
// background layer surface through the custom Xwayland Satellite bridge.
// xwayland-satellite {
//     path "~/.local/bin/xwayland-satellite-wallpaper"
// }

// The rice helper starts QuickShell; configuration changes reload automatically.
// Initialize GNOME Keyring for the Secret Service D-Bus API (org.freedesktop.secrets),
// required by apps like Mailspring that use libsecret for credential storage.
// spawn-at-startup "sh" "-c" "sleep 1 && pgrep -xa tailscale | grep -q ' systray$' || exec tailscale systray"
// warp-taskbar is owned by its packaged user service. Starting it directly
// here makes it spin when the warp-svc daemon has not started yet.
// KDE daemon -- required for Dolphin's "Open With" dialog, MIME associations,
// and other KIO services. Without it, Dolphin can't discover installed apps.
// Delay kded6 so QuickShell can claim the StatusNotifierWatcher D-Bus name first;
// otherwise kded6 claims it but doesn't export the object path, breaking the tray.

// One medium glass blur for app windows and client-shaped shell surfaces.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.0
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.7
    // Gentler glide when focus-follows-mouse brings another column into view.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.00001
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    popups {
        geometry-corner-radius 12
    }
}

window-rule {
    match app-id=r#"^(code|Code|VSCodium|zen|google-chrome|chromium|firefox|discord|steam|dev.zed.Zed|helium|t3code)$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="dev.radhey.VictusControl"
    default-column-width { fixed 840; }
    default-window-height { fixed 366; }
}

window-rule {
    match app-id="cider"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="io.github.jR4dh3y.wallpygui"
    open-floating true
}

window-rule {
    match app-id="org.kde.dolphin"
    opacity 0.88
}

window-rule {
    match app-id="thunar"
    opacity 0.88
}

// Spotify glass: preserve the dark palette while revealing the wallpaper.
window-rule {
    match app-id=r#"^(Spotify|spotify|com\.spotify\.Client)$"#
    opacity 0.80
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    background-effect {
        blur true
        xray false
    }
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
            xray false
        }
    }
}

layer-rule {
    match namespace="wayland-pet"
    background-effect {
        blur false
    }
}

// The shell supplies rounded ext-background-effect regions for visible panels.
// Leave blur unset: forcing it would replace those shapes with the whole surface.
// Both namespaces can survive QML hot reloads from an earlier shell version.
layer-rule {
    match namespace=r#"^(rebos_shell|nonchalant)(?::.*)?$"#
    background-effect {
        xray false
    }
}

// Plain QuickShell surfaces use full-screen transparent layers like
// rebos_shell does. Keep them unblurred so the shell stays crisp.
layer-rule {
    match namespace=r#"^quickshell(?::.*)?$"#
    background-effect {
        blur false
    }
}

layer-rule {
    match namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur false
    }
}

layer-rule {
    match layer="top"
    match layer="overlay"
    exclude namespace="wayland-pet"
    exclude namespace=r#"^(rebos_shell|nonchalant)(?::.*)?$"#
    exclude namespace=r#"^quickshell(?::.*)?$"#
    exclude namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur true
        xray false
    }
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}

// Other bottom/background clients use the same background sampling policy.
layer-rule {
    match layer="bottom"
    match layer="background"
    exclude namespace=r#"^(rebos_shell|nonchalant)(?::.*)?$"#
    exclude namespace=r#"^quickshell(?::.*)?$"#
    exclude namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="floating"
    open-floating true
    min-width 800
    min-height 700
    max-width 800
    max-height 700
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="project-picker"
    open-floating true
    min-width 500
    min-height 390
    max-width 500
    max-height 390
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match app-id="menu"
    open-floating true
    min-width 300
    min-height 250
    max-width 300
    max-height 250
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="port"
    open-floating true
    min-width 850
    min-height 400
    max-width 850
    max-height 400
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="kill"
    open-floating true
    min-width 700
    min-height 500
    max-width 700
    max-height 500
    geometry-corner-radius 12
    clip-to-geometry true
}

// Wallpaper Engine creates a blank XWayland helper/tray window on niri.
// Do not bridge it with xembedsniproxy: clicking that Wine tray icon can crash XWayland/Steam.
window-rule {
    match app-id="steam_app_431960" title="^$"
    open-floating true
    open-focused false
    min-width 1
    min-height 1
    max-width 1
    max-height 1
    opacity 0.0
    geometry-corner-radius 12
    clip-to-geometry true
}

// Steam main window - fullscreen
window-rule {
    match app-id="steam" title="^Steam$"
    open-floating false
}

// Steam Friends List - tiled with specific size
window-rule {
    match app-id="steam" title="^Friends List$"
    open-floating false
    min-width 378
    max-width 378
    min-height 1036
    max-height 1036
}
window-rule {
    match app-id="steam" title="^$"
    open-floating true
    min-width 814
    max-width 814
    min-height 765
    max-height 765
}

// Open browsers on the current workspace.
window-rule {
    match app-id="zen-browser"
    match app-id="zen"
    open-focused true
}

window-rule {
    match app-id="chrome-web.whatsapp.com__-Default"
    default-column-width { fixed 1335; }
    default-window-height { fixed 1036; }
}

// WhatsApp Web, Steam
window-rule {
    match app-id="chrome-web.whatsapp.com__-Default"
    match app-id="steam"
    open-focused true
}

// Cider, OBS
window-rule {
    match app-id="Cider"
    match app-id="com.obsproject.Studio"
    open-focused true
}

// Editors
window-rule {
    match app-id="code"
    match app-id="dev.zed.Zed"
    match app-id="t3code"
    open-focused true
}

binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name

    // rebos_shell QuickShell actions.
    Mod+Alt+F hotkey-overlay-title="File Shelf" { spawn "qs" "ipc" "call" "rebos_shell" "run" "file-shelf"; }
    Mod+Space hotkey-overlay-title="Open App Launcher" { spawn "qs" "ipc" "call" "rebos_shell" "run" "launcher"; }
    Mod+Alt+N hotkey-overlay-title="Quick Notes" { spawn "qs" "ipc" "call" "rebos_shell" "run" "notes"; }
    Mod+N hotkey-overlay-title="Open Dashboard" { spawn "qs" "ipc" "call" "rebos_shell" "run" "system-monitor"; }
    Mod+V hotkey-overlay-title="Open Clipboard History" { spawn "rebos-clipboard"; }
    Mod+Period hotkey-overlay-title="Open App Launcher" { spawn "qs" "ipc" "call" "rebos_shell" "run" "launcher"; }
    Mod+C hotkey-overlay-title="Open Project" { spawn "qs" "ipc" "call" "rebos_shell" "run" "projects"; }
    Mod+Shift+C hotkey-overlay-title="Open Zed Project" { spawn "project-picker"; }
    Mod+A hotkey-overlay-title="Open AI Assistant" { spawn "qs" "ipc" "call" "rebos_shell" "run" "assistant"; }
    Mod+Shift+A repeat=false hotkey-overlay-title="Open Anime Streamer" { spawn "@HOME@/.local/bin/anime-streamer"; }

    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "kitty"; }
    Mod+W repeat=false hotkey-overlay-title="Open a Web Browser" { spawn "zen-browser"; }
    // Keypad 1/2 are reported as KP_End/KP_Down when Num Lock is off.
    Mod+KP_1 hotkey-overlay-title="Open ChatGPT" { spawn ".config/scripts/browser-app" "https://chatgpt.com/"; }
    Mod+KP_End hotkey-overlay-title="Open ChatGPT" { spawn ".config/scripts/browser-app" "https://chatgpt.com/"; }
    Mod+KP_2 hotkey-overlay-title="Open WhatsApp" { spawn ".config/scripts/browser-app" "https://web.whatsapp.com/"; }
    Mod+KP_Down hotkey-overlay-title="Open WhatsApp" { spawn ".config/scripts/browser-app" "https://web.whatsapp.com/"; }
    Mod+E hotkey-overlay-title="Open a File Manager" { spawn "thunar"; }
    Mod+M hotkey-overlay-title="Open Cider" { spawn "spotify-launcher"; }
    Mod+X hotkey-overlay-title="Open the Power Menu" { spawn "qs" "ipc" "call" "rebos_shell" "run" "powermenu"; }
    Mod+I hotkey-overlay-title="Install a program" {spawn "kitty" "--class" "floating" ".config/scripts/install.sh"; }
    Mod+O hotkey-overlay-title="Install a program (aur)"{spawn "kitty" "--class" "floating" ".config/scripts/install-aur.sh"; }
    Mod+U hotkey-overlay-title="Uninstall a program "{spawn "kitty" "--class" "floating" ".config/scripts/uninstall.sh"; }
    Mod+P hotkey-overlay-title="Port Manager" {spawn "kitty" "--class" "port" ".config/scripts/port-manager.sh";}
    Mod+Alt+L hotkey-overlay-title="Lock Desktop" { spawn "qs" "ipc" "call" "lockscreen" "lock"; }
    Mod+Z hotkey-overlay-title="Refresh app colors" { spawn "qs" "ipc" "call" "theme" "sync"; }
    // Mod+Space hotkey-overlay-title="Transcribe Audio" { spawn "sh" ".config/scripts/whisper-transcribe.sh"; }
    // Alt+Space hotkey-overlay-title="Cloud Transcribe" { spawn "sh" ".config/scripts/whisper-cloud.sh"; }

    // Route media keys through rebos_shell so its OSD stays in sync.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "increment"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "decrement"; }
    XF86AudioMute         allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "toggleMute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "qs" "ipc" "call" "audio" "toggleMicMute"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "ipc" "call" "brightness" "decrement"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "ipc" "call" "brightness" "increment"; }

    Mod+Tab repeat=false { toggle-overview; }

    Mod+Shift+W hotkey-overlay-title="Open Wallpapers" { spawn "qs" "ipc" "call" "rebos_shell" "run" "wallpapers"; }
    Mod+Alt+Left repeat=false hotkey-overlay-title="Previous wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "previous"; }
    Mod+Alt+Right repeat=false hotkey-overlay-title="Next wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "next"; }
    Mod+Alt+W repeat=false hotkey-overlay-title="Random wallpaper (1920x1200)" { spawn "@HOME@/.local/bin/wallpaper-switcher" "random"; }
    Mod+Shift+N hotkey-overlay-title="New Window Rule" { spawn "qs" "ipc" "call" "rebos_shell" "run" "new-window-rule"; }

    Mod+Q { close-window; }
    Mod+H  { focus-column-left; }
    Mod+J  { focus-window-down; }
    Mod+K    { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H  { move-column-left; }
    Mod+Ctrl+J  { move-window-down; }
    Mod+Ctrl+K    { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+H  { focus-monitor-left; }
    Mod+Shift+J  { focus-monitor-down; }
    Mod+Shift+K    { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }


    Mod+Shift+Ctrl+H  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Shift+Page_Down { spawn "sh" "-c" ".config/scripts/scale-adjust.sh -0.05"; }
    Shift+Page_Up   { spawn "sh" "-c" ".config/scripts/scale-adjust.sh +0.05"; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Switch to numbered workspaces directly with Mod+Number.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    // Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    // Mod+Shift+5 { move-column-to-workspace 5; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+G      { toggle-window-floating; }
    Mod+Shift+G { switch-focus-between-floating-and-tiling; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    // Capture the complete layout at native output scale and copy it as PNG.
    Mod+Shift+Print hotkey-overlay-title=null { spawn-sh "grim - | wl-copy --type image/png"; }
    Mod+Print hotkey-overlay-title="Copy Latest Screenshot Path" { spawn ".config/scripts/copy-latest-screenshot-path.sh"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }

    Mod+Shift+P { power-off-monitors; }
}

// Follow the wallpaper palette without changing layout or restarting Niri.
include optional=true "~/.cache/rebos_shell/niri-colors.kdl"

// The pinned assistant is a normal tiled client, scoped by its own title.
window-rule {
    match app-id=r#"^(org\.quickshell|quickshell)([.:].*)?$"# title="^rebos_shell Assistant$"
    open-floating false
}

spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "exec udiskie --no-notify"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
