input {
    // Avoid re-suspending on firmware power-button events during wake.
    // Paired with /etc/systemd/logind.conf.d/90-lid-wake.conf.
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        // off
        tap
        dwt
        dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        accel-speed 0
        accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // middle-emulation
    }

    //warp-mouse-to-focus
    // Click to focus; hovering must not switch windows or tabs.
}



layout {
    gaps 4
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
    focus-ring {
        off
        inactive-color "#505050"
    }
    border {
        on
        width 3
    }
    shadow {
        on
        softness 50
        spread 12
        offset x=0 y=8
        color "#00000060"
    }
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}


environment {
    XDG_MENU_PREFIX "arch-"
    PATH "@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
}

// Render Wallpaper Engine's "Wallpaper Pop-out" X11 window directly as a
// background layer surface through the custom Xwayland Satellite bridge.
// xwayland-satellite {
//     path "~/.local/bin/xwayland-satellite-wallpaper"
// }

// The rice helper starts QuickShell; configuration changes reload automatically.
// Initialize GNOME Keyring for the Secret Service D-Bus API (org.freedesktop.secrets),
// required by apps like Mailspring that use libsecret for credential storage.
// spawn-at-startup "sh" "-c" "sleep 1 && pgrep -xa tailscale | grep -q ' systray$' || exec tailscale systray"
// warp-taskbar is owned by its packaged user service. Starting it directly
// here makes it spin when the warp-svc daemon has not started yet.
// Discord starts on demand to avoid keeping a hidden browser engine in memory.
// KDE daemon -- required for Dolphin's "Open With" dialog, MIME associations,
// and other KIO services. Without it, Dolphin can't discover installed apps.
// Delay kded6 so QuickShell can claim the StatusNotifierWatcher D-Bus name first;
// otherwise kded6 claims it but doesn't export the object path, breaking the tray.

// One medium glass blur for app windows and client-shaped shell surfaces.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.0
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.7
    // Gentler glide when focus-follows-mouse brings another column into view.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.00001
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    popups {
        geometry-corner-radius 16
    }
}

window-rule {
    match app-id=r#"^(code|Code|VSCodium|zen|google-chrome|chromium|firefox|discord|steam|dev.zed.Zed|helium|t3code)$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="vlc"
    default-column-width { proportion 1.0; }
    default-window-height { proportion 1.0; }
}

window-rule {
    match app-id="dev.radhey.VictusControl"
    default-column-width { fixed 840; }
    default-window-height { fixed 366; }
}

window-rule {
    match app-id="cider"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="io.github.jR4dh3y.wallpygui"
    open-floating true
}

window-rule {
    match app-id="org.kde.dolphin"
    opacity 0.88
}

window-rule {
    match app-id="thunar"
    opacity 0.88
}

// Spotify glass: preserve the dark palette while revealing the wallpaper.
window-rule {
    match app-id=r#"^(Spotify|spotify|com\.spotify\.Client)$"#
    opacity 0.80
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    background-effect {
        blur true
        xray false
    }
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
            xray false
        }
    }
}

layer-rule {
    match namespace="wayland-pet"
    background-effect {
        blur false
    }
}

// The shell supplies rounded ext-background-effect regions for visible panels.
// Leave blur unset: forcing it would replace those shapes with the whole surface.
// Both namespaces can survive QML hot reloads from an earlier shell version.
layer-rule {
    match namespace=r#"^rebos_shell(?::.*)?$"#
    background-effect {
        xray false
    }
}

// Plain QuickShell surfaces use full-screen transparent layers like
// rebos_shell does. Keep them unblurred so the shell stays crisp.
layer-rule {
    match namespace=r#"^quickshell(?::.*)?$"#
    background-effect {
        blur false
    }
}

layer-rule {
    match namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur false
    }
}

layer-rule {
    match layer="top"
    match layer="overlay"
    exclude namespace="wayland-pet"
    exclude namespace=r#"^rebos_shell(?::.*)?$"#
    exclude namespace=r#"^quickshell(?::.*)?$"#
    exclude namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur true
        xray false
    }
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}

// Other bottom/background clients use the same background sampling policy.
layer-rule {
    match layer="bottom"
    match layer="background"
    exclude namespace=r#"^rebos_shell(?::.*)?$"#
    exclude namespace=r#"^quickshell(?::.*)?$"#
    exclude namespace=r#"(?i)^sttd(?::.*)?$"#
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="floating"
    open-floating true
    min-width 800
    min-height 700
    max-width 800
    max-height 700
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="project-picker"
    open-floating true
    min-width 500
    min-height 390
    max-width 500
    max-height 390
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match app-id="menu"
    open-floating true
    min-width 300
    min-height 250
    max-width 300
    max-height 250
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="port"
    open-floating true
    min-width 850
    min-height 400
    max-width 850
    max-height 400
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="kill"
    open-floating true
    min-width 700
    min-height 500
    max-width 700
    max-height 500
    geometry-corner-radius 12
    clip-to-geometry true
}

// Wallpaper Engine creates a blank XWayland helper/tray window on niri.
// Do not bridge it with xembedsniproxy: clicking that Wine tray icon can crash XWayland/Steam.
window-rule {
    match app-id="steam_app_431960" title="^$"
    open-floating true
    open-focused false
    min-width 1
    min-height 1
    max-width 1
    max-height 1
    opacity 0.0
    geometry-corner-radius 12
    clip-to-geometry true
}

// Steam main window - fullscreen
window-rule {
    match app-id="steam" title="^Steam$"
    open-floating false
}

// Steam Friends List - tiled with specific size
window-rule {
    match app-id="steam" title="^Friends List$"
    open-floating false
    min-width 378
    max-width 378
    min-height 1036
    max-height 1036
}
window-rule {
    match app-id="steam" title="^$"
    open-floating true
    min-width 814
    max-width 814
    min-height 765
    max-height 765
}

// Open browsers on the current workspace.
window-rule {
    match app-id="zen-browser"
    match app-id="zen"
    open-focused true
}

window-rule {
    match app-id="chrome-web.whatsapp.com__-Default"
    default-column-width { fixed 1335; }
    default-window-height { fixed 1036; }
}

// WhatsApp Web, Steam
window-rule {
    match app-id="chrome-web.whatsapp.com__-Default"
    match app-id="steam"
    open-focused true
}

// Cider, OBS
window-rule {
    match app-id="Cider"
    match app-id="com.obsproject.Studio"
    open-focused true
}

// Editors
window-rule {
    match app-id="code"
    match app-id="dev.zed.Zed"
    match app-id="t3code"
    open-focused true
}

// Keyboard defaults and personal overrides are loaded by config.kdl.


// Follow the wallpaper palette without changing layout or restarting Niri.
include optional=true "~/.cache/rebos_shell/niri-colors.kdl"

// Settings uses its own surface and control borders.
window-rule {
    match app-id=r#"^(org\.quickshell|quickshell)([.:].*)?$"# title="^rebos_shell Settings$"
    border {
        off
    }
}

// The pinned assistant is a normal tiled client, scoped by its own title.
window-rule {
    match app-id=r#"^(org\.quickshell|quickshell)([.:].*)?$"# title="^rebos_shell Assistant$"
    open-floating false
}

// Ghost uses a full-width tiled workspace.
window-rule {
    match app-id="org.ghostlocation.desktop"
    open-floating false
    default-column-width { proportion 1.0; }
    geometry-corner-radius 16
    clip-to-geometry true
}


spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "exec udiskie --no-notify"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"

// Compact fan controls share the shell surface and stay above tiled windows.
window-rule {
    match app-id=r#"^(org\.quickshell|quickshell)([.:].*)?$"# title="^ThinkPad Fan Control$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 360; }
    border { off; }
}
