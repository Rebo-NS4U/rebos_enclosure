/* System Theme Playground: generated from the active desktop theme. */
@define-color theme_bg_color {{background}};
@define-color theme_fg_color {{overBackground}};
@define-color theme_base_color {{surfaceContainerLowest}};
@define-color theme_text_color {{overBackground}};
@define-color theme_selected_bg_color {{primary}};
@define-color theme_selected_fg_color {{overPrimary}};
@define-color accent_bg_color {{primary}};
@define-color accent_fg_color {{overPrimary}};
* { font-family: "{{font}}"; font-size: {{fontSize}}px; }
window { background-color: {{background}}; color: {{overBackground}}; }
label { color: {{overBackground}}; }
frame.background, frame.background.noctalia-login {
  background-color: alpha({{background}}, {{opacity}});
  background-image: none;
  border: 1px solid {{outlineVariant}};
  border-radius: {{radius}}px;
  padding: 28px 32px;
  box-shadow: 0 8px 24px alpha(black, 0.25);
}
frame.background > border { border: none; }
frame.background > grid { min-width: 460px; }
frame.background > grid > label:first-child {
  font-size: 28px; font-weight: 600; margin-bottom: 24px;
}
entry, passwordentry, combobox > box > button {
  background: {{surfaceContainerLowest}}; color: {{overBackground}};
  border: 1px solid {{outlineVariant}}; border-radius: {{radius}}px;
  min-height: 30px; padding: 8px 14px; box-shadow: none;
}
passwordentry entry { background: transparent; border: none; padding: 0; min-height: 0; box-shadow: none; }
combobox arrow { color: {{overBackground}}; min-width: 14px; }
entry:focus-within, passwordentry:focus-within, button:focus-visible {
  outline: 2px solid {{primary}}; outline-offset: -2px;
}
button {
  background: {{surfaceContainer}}; color: {{overBackground}};
  border: 1px solid {{outlineVariant}}; border-radius: {{radius}}px;
  min-height: 24px; padding: 7px 14px; box-shadow: none;
}
button:hover, combobox > box > button:hover { background: {{surfaceContainerHigh}}; }
button:active, button:checked, button.suggested-action {
  background: {{primary}}; color: {{overPrimary}}; border-color: {{primary}};
}
button:active label, button:checked label, button.suggested-action label { color: {{overPrimary}}; }
button.suggested-action { min-width: 104px; }
button.suggested-action:hover { background: shade({{primary}}, 1.08); }
button:disabled, entry:disabled, passwordentry:disabled { opacity: 0.4; }
button.toggle { min-height: 0; padding: 6px 10px; }
button.destructive-action:hover { border-color: {{error}}; }
popover contents {
  background: {{surfaceContainer}}; color: {{overBackground}};
  border: 1px solid {{outlineVariant}}; border-radius: {{radius}}px;
  padding: 6px; box-shadow: 0 8px 24px alpha(black, 0.25);
}
popover modelbutton {
  min-height: 24px; padding: 8px 12px; border-radius: {{innerRadius}}px;
}
popover modelbutton:hover { background: {{surfaceContainerHigh}}; }
infobar { background: {{surfaceContainer}}; color: {{overBackground}}; border-radius: {{radius}}px; }
selection { background: {{primary}}; color: {{overPrimary}}; }
/* Clock header: generous time, a quiet date badge, then a clear sign-in boundary. */
.noctalia-login .card-time {
  font-size: 56px;
  font-weight: 400;
  letter-spacing: -2px;
  color: {{primary}};
  margin-top: 4px;
  text-shadow: 0 2px 12px alpha({{primary}}, 0.12);
}
.noctalia-login .card-date {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.5px;
  color: {{overBackground}};
  background: alpha({{primary}}, 0.08);
  border: 1px solid alpha({{primary}}, 0.16);
  border-radius: {{radius}}px;
  padding: 8px 12px;
  margin: 12px 16px 26px;
}
.noctalia-login .login-heading {
  font-size: 16px;
  font-weight: 600;
  border-top: 1px solid alpha({{outlineVariant}}, 0.65);
  padding-top: 22px;
  margin-bottom: 14px;
}
.noctalia-login .field-caption { margin-top: 6px; margin-left: 3px; }
.noctalia-hud button.destructive-action { margin-bottom: 0; }
.noctalia-hud button.power-symbol { min-width: 32px; min-height: 32px; padding: 7px; }
.noctalia-hud button.power-symbol image { color: {{overBackground}}; }
frame.background.noctalia-clock-fallback,
frame.background + frame.background {
  background: transparent; border: none; box-shadow: none;
}
