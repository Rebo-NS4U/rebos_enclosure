[Unit]
Description=Watch desktop wallpaper and palette for Quickshell greeter

[Path]
PathChanged=@HOME@/.cache/rebos_shell/wallpapers.json
PathChanged=@HOME@/.cache/rebos_shell/effective-palette.json
PathChanged=@HOME@/.config/enclosure/shell/config/theme.json
PathChanged=@HOME@/.config/enclosure/shell/config/bar.json
Unit=greeter-sync.service

[Install]
WantedBy=default.target
