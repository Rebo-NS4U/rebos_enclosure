#!/usr/bin/python3
"""Publish the current desktop wallpaper and effective palette for the Quickshell greeter."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

from PIL import Image, ImageOps

HOME = Path.home()
CACHE = HOME / '.cache/rebos_shell'
TARGET = Path('/var/lib/rebos-greeter/theme')


def atomic_write(path, data):
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            os.fchmod(stream.fileno(), 0o644)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    state = json.loads((CACHE / 'wallpapers.json').read_text())
    wallpaper = Path(state['currentWall'])
    palette = json.loads((CACHE / 'effective-palette.json').read_text())

    # The effective palette already contains the shared surface hierarchy.
    # Read geometry separately so font/corner changes invalidate the CSS stamp.
    try:
        theme = json.loads((HOME / '.config/enclosure/shell/config/theme.json').read_text())
    except (OSError, ValueError):
        theme = {}
    def number(key, default, low, high):
        try:
            return max(low, min(high, int(theme.get(key, default))))
        except (TypeError, ValueError):
            return default
    font = str(theme.get('font', 'JetBrains Mono'))
    if not re.fullmatch(r'[\w .+-]{1,80}', font):
        font = 'JetBrains Mono'
    radius = number('roundness', 16, 0, 40)
    try:
        opacity = max(0, min(1, float(palette.get('opacity', 1))))
    except (TypeError, ValueError):
        opacity = 1
    metrics = {'font': font, 'fontSize': str(number('fontSize', 14, 8, 32)),
               'radius': str(radius), 'innerRadius': str(max(0, radius - 6)),
               'opacity': str(opacity)}

    info = wallpaper.stat()
    image_signature = [str(wallpaper), info.st_mtime_ns, info.st_size]
    # Export only appearance, never shell settings containing personal state.
    colors = {key: value for key, value in palette.items()
              if isinstance(value, str) and re.fullmatch(r'#[0-9a-fA-F]{6}', value)}
    colors['foreground'] = colors.get('overBackground', '#eeeeee')
    try:
        bar = json.loads((HOME / '.config/enclosure/shell/config/bar.json').read_text())
    except (OSError, ValueError):
        bar = {}
    exported = {'display': {'use12hFormat': bar.get('use12hFormat', True) is True,
                            'tintEnabled': state.get('tintEnabled', False) is True},
                'palette': colors, 'metrics': {
        'font': font, 'fontSize': int(metrics['fontSize']), 'radius': radius,
        'style': str(theme.get('shellStyle', 'quiet'))}}
    # Material geometry only. Do not copy the full user settings tree.
    material = {
        'shellStyle': str(theme.get('shellStyle', 'quiet')),
        'roundness': radius, 'font': font, 'fontSize': int(metrics['fontSize']),
        'monoFontSize': int(metrics['fontSize']),
        'ditherStrength': number('ditherStrength', 20, 0, 100),
        'shellTransparency': number('shellTransparency', -1, -1, 100),
        'animDuration': number('animDuration', 0, 0, 2000),
        'shadowXOffset': number('shadowXOffset', 0, -100, 100),
        'shadowYOffset': number('shadowYOffset', 0, -100, 100),
        'shadowBlur': number('shadowBlur', 1, 0, 16),
    }
    def color(value):
        return isinstance(value, str) and (value in colors or
               re.fullmatch(r'#[0-9a-fA-F]{6,8}', value) or value == 'transparent')
    shadow = theme.get('shadowColor', 'shadow')
    material['shadowColor'] = shadow if color(shadow) else 'shadow'
    try:
        material['shadowOpacity'] = max(0, min(1, float(theme.get('shadowOpacity', 0))))
    except (TypeError, ValueError):
        material['shadowOpacity'] = 0
    for key in ('srBg', 'srPopup', 'srInternalBg', 'srPane', 'srCommon', 'srFocus',
                'srPrimary', 'srPrimaryFocus', 'srOverPrimary', 'srSecondary',
                'srSecondaryFocus', 'srOverSecondary', 'srTertiary', 'srTertiaryFocus',
                'srOverTertiary', 'srError', 'srErrorFocus', 'srOverError', 'srBarBg'):
        original = theme.get(key)
        if not isinstance(original, dict):
            continue
        surface = {}
        for field, value in original.items():
            if field in ('gradientAngle', 'gradientCenterX', 'gradientCenterY',
                         'halftoneDotMin', 'halftoneDotMax', 'halftoneStart',
                         'halftoneEnd', 'opacity', 'radius'):
                if isinstance(value, (float, int)) and not isinstance(value, bool) and -360 <= value <= 360:
                    surface[field] = value
            elif field in ('itemColor', 'color', 'halftoneDotColor', 'halftoneBackgroundColor'):
                if color(value):
                    surface[field] = value
            elif field == 'gradientType' and value in ('linear', 'radial', 'halftone'):
                surface[field] = value
            elif field == 'gradient' and isinstance(value, list):
                surface[field] = [stop for stop in value[:8]
                                  if isinstance(stop, list) and len(stop) == 2 and color(stop[0])
                                  and isinstance(stop[1], (int, float)) and 0 <= stop[1] <= 1]
            elif field == 'border' and isinstance(value, list) and len(value) == 2:
                if color(value[0]) and isinstance(value[1], (int, float)) and 0 <= value[1] <= 16:
                    surface[field] = value
        material[key] = surface
    exported['material'] = material
    appearance = json.dumps(exported).encode()
    signature = {'image': image_signature,
                 'quickshell': hashlib.sha256(appearance).hexdigest()}
    stamp = CACHE / 'greeter-sync.json'
    previous = json.loads(stamp.read_text()) if stamp.exists() else {}
    if previous.get('image') != image_signature or not (TARGET / 'background.png').exists():
        if wallpaper.suffix.lower() in {'.mp4', '.webm', '.mkv', '.mov', '.avi', '.m4v'}:
            frame = subprocess.run(['ffmpeg', '-v', 'error', '-i', str(wallpaper),
                                    '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'],
                                   check=True, capture_output=True, timeout=60).stdout
            source = io.BytesIO(frame)
        else:
            source = wallpaper
        with Image.open(source) as image:
            image = ImageOps.exif_transpose(image).convert('RGB')
            image.thumbnail((3840, 2160))
            output = io.BytesIO()
            image.save(output, format='PNG')
        atomic_write(TARGET / 'background.png', output.getvalue())
    if previous.get('quickshell') != signature['quickshell'] or not (TARGET / 'quickshell.json').exists():
        atomic_write(TARGET / 'quickshell.json', appearance)
    if previous != signature:
        atomic_write(stamp, json.dumps(signature).encode())
        print('Quickshell greeter wallpaper and colors synchronized', flush=True)


if __name__ == '__main__':
    main()
