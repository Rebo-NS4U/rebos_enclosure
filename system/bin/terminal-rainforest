#!/usr/bin/env python3
"""A procedural forest-interior greeting using the terminal's own ANSI palette."""
import argparse
import math
import os
import random
import shutil
import sys
from pathlib import Path
from types import SimpleNamespace

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "share/terminal-rainforest"))
from pybonsai import draw, tree

RESET = '\033[0m'
# Standard palette slots follow the terminal theme, including live theme changes.
COLORS = ('', '\033[36m', '\033[32m', '\033[92m')


class ForestCanvas(draw.TerminalWindow):
    """Collect upstream geometry without printing or taking cursor ownership."""
    def __init__(self, width, height, options):
        super().__init__(width, height, options)
        self.chars = [[(' ', 0) for _ in range(width)] for _ in range(height)]

    def set_char_instant(self, x, y, char, colour, is_screen_coords):
        if not is_screen_coords:
            x, y = self.plane_to_screen(x, y)
        if 0 <= x < self.height and 0 <= y < self.width:
            # Upstream foliage is green; wood has a nonzero red component.
            layer = (2 if colour[1] < 160 else 3) if colour[0] == 0 else 1
            self.chars[x][y] = (char, layer)


def forest(width,height,seed=None):
    state=random.getstate();random.seed(seed)
    try:
        opts=SimpleNamespace(initial_len=height*.3,num_layers=6,
            angle_mean=math.radians(48),leaf_len=max(2,round(height/6)),
            leaf_chars='&%#@',branch_chars=':;',instant=True,fixed_window=True)
        c=ForestCanvas(width,height,opts)
        def point(x,y,char,layer):
            row,col=c.plane_to_screen(x,y)
            if 0<=row<height and 0<=col<width:c.chars[row][col]=(char,layer)
        # Distant, slender trees in a higher ground plane.
        for x in range(3,width,9):
            x+=random.uniform(-2,2)
            for y in range(5,height*2):
                point(x+math.sin(y*.12)*.5,y,':',1)
        # Tall foreground trunks support a connected ceiling, not isolated crowns.
        spacing=max(12,round(height*1.15))
        for center in range(-3,width+spacing,spacing):
            x=center+random.uniform(-2,2)
            fork=height*random.uniform(1.25,1.5)
            lean=random.uniform(-2,2)
            for y in range(2,math.ceil(fork)+1):
                pos=x+lean*y/fork
                point(pos-.5,y,'|',1);point(pos+.5,y,'|',1)
            point(x-2,2,'/',1);point(x+2,2,'\\',1)
            point(x-3,1,'_',1);point(x+3,1,'_',1)
            t=tree.RandomOffsetFibTree(c,(x+lean,fork),opts)
            for sign in (-1,1):
                t.draw_branch(x+lean,fork,0,0,height*random.uniform(.22,.34),1,sign*.85)
        # Hanging lianas stay in the upper half of the clearing.
        for center in range(6,width,17):
            length=random.randint(max(2,height//4),max(3,height//2))
            for row in range(length):
                col=center+round(math.sin(row*.5))
                if 0<=col<width and c.chars[row][col][0]==' ':
                    c.chars[row][col]=(':' if row%3 else '|',2)
        # Ferns form little fans; retain gaps between plants.
        for x in range(2,width,7):
            size=random.choice((2,3))
            point(x,2,'|',2)
            for step in range(1,size):
                point(x-step,2+step*.8,'\\',2)
                point(x+step,2+step*.8,'/',2)
            point(x,3,'v',3)
        # Occasional mushroom pairs and tiny points of light in the clearing.
        for x in range(9,width,29):
            point(x,2,'o',3);point(x,1,'|',1)
            point(x+2,1,'o',2)
        for _ in range(max(1,width//25)):
            col=random.randrange(width)
            row=random.randrange(max(1,height//2),max(height//2+1,height-3))
            if c.chars[row][col][0]==' ':c.chars[row][col]=('.',3)
        return c.chars
    finally:random.setstate(state)

def render(columns, rows, seed=None, plain=False):
    # One spare column avoids automatic wrapping; leave ample prompt space.
    if columns < 24 or rows < 10:
        return ''
    height = min(20, max(6, rows // 2))
    lines = []
    for row in forest(columns-1, height, seed):
        line, previous = '', None
        for glyph, layer in row:
            if not plain and layer != previous:
                line += COLORS[layer] or RESET
            line += glyph
            previous = layer
        lines.append(line.rstrip() + ('' if plain else RESET))
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seed', type=int, help='Reproduce a particular forest')
    parser.add_argument('--plain', action='store_true', help='Export without colors, even when redirected')
    args = parser.parse_args()
    if not args.plain and (not sys.stdout.isatty() or os.environ.get('TERM', 'dumb') == 'dumb'):
        return
    columns, rows = shutil.get_terminal_size()
    picture = render(columns, rows, args.seed, args.plain or 'NO_COLOR' in os.environ)
    if picture:
        print(picture + '\n')


if __name__ == '__main__':
    main()
