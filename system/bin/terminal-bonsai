#!/usr/bin/env python3
"""Procedural, seed-to-canopy bonsai greeting. Python standard library only."""
import argparse
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import sys
import time

RESET = '\033[0m'
PALETTE = dict(primary='#ffb4a2', secondary='#e7bdb3', tertiary='#dac58d', outline='#a08c88')


class Tree:
    """A stable miniature landscape: curved wood, tiered pads, then leaf buds.

    Geometry lives on a fixed canvas, so resizing cannot change the specimen.
    Every stroke has a birth time; foliage expands outward from its own twig.
    """
    def __init__(self, width, height, seed=None):
        self.width, self.height = width, height
        self.rng = random.Random(seed)
        self.center = width // 2
        self.phase = self.rng.uniform(0, math.tau)
        self.wood, self.leaves = [], []
        rng = self.rng
        lean = rng.uniform(-5, 5)
        phase = self.phase

        def trunk(t):
            return (36 + lean * t + math.sin(t * 6 + phase) * 5 * math.sin(t * math.pi * .85),
                    26 - 22 * t)

        self.trunk = trunk
        # A single centerline with continuous taper, rather than stacked strokes.
        for i in range(265):
            t = i / 264
            x, y = trunk(t)
            self.wood.append((x, y, .015 + t * .53, 2.2 * (1 - t) ** 1.6, 0))

        side = rng.choice((-1, 1))
        for i, t in enumerate((.28, .44, .60, .75, .90)):
            direction = side * (-1 if i % 2 else 1)
            start = trunk(t)
            reach = (1 - t) * rng.uniform(21, 27) + 4
            end = (start[0] + direction * reach, start[1] - rng.uniform(1.6, 3.2))
            birth = .015 + t * .53
            duration = .14 + (1 - t) * .06
            control = (start[0] + direction * reach * .32, start[1] + rng.uniform(.4, 1.2))
            self.curve(start, control, end, birth, duration, .65 * (1 - t) + .16)
            # Each branch carries two rising fans with separate foliage pads.
            for fraction in (.60, 1):
                u = fraction
                bx = (1-u)**2 * start[0] + 2*(1-u)*u * control[0] + u*u * end[0]
                by = (1-u)**2 * start[1] + 2*(1-u)*u * control[1] + u*u * end[1]
                spread = rng.uniform(3.2, 4.8) * (1.1 - t * .35)
                for fan in (-1, 0, 1):
                    tip = (bx + fan * spread * .68, by - rng.uniform(.8, 1.8))
                    twig_birth = birth + duration * fraction
                    self.curve((bx, by), (bx + fan, by - .6), tip, twig_birth, .08, .08)
                    self.pad(tip[0], tip[1] - .25, spread * .75, rng.uniform(1.35, 1.8),
                             twig_birth + .08, .16)
        x, y = trunk(1)
        self.pad(x, y - .5, 4.2, 1.5, .69, .24)

    def curve(self, start, control, end, birth, duration, thickness):
        for i in range(101):
            t = i / 100
            x = (1-t)**2 * start[0] + 2*(1-t)*t*control[0] + t*t*end[0]
            y = (1-t)**2 * start[1] + 2*(1-t)*t*control[1] + t*t*end[1]
            self.wood.append((x, y, birth + duration*t, thickness*(1-t), 1))

    def pad(self, x, y, radius, depth, birth, duration):
        rng = self.rng
        for py in range(math.floor(y-depth), math.ceil(y+depth)+1):
            for px in range(math.floor(x-radius), math.ceil(x+radius)+1):
                r = ((px-x)/radius)**2 + ((py-y)/depth)**2
                if r > 1 or rng.random() < .08:
                    continue
                # Buds progress along the twig, into the pad, then to its edge.
                when = birth + duration * (.15 + .7 * math.sqrt(r) + rng.random() * .15)
                tone = 'tertiary' if py < y - .3 else 'primary'
                shade = 1 if py < y - .3 else .78 if py < y + .3 else .46
                glyph = '·' if r > .8 else '•' if r > .35 else '●'
                self.leaves.append((px, py, when, glyph, tone, shade))

    def cells(self, age):
        age = max(0, min(1, age))
        grid = [[(' ', 'outline', 1) for _ in range(self.width)] for _ in range(self.height)]
        sx, sy = (self.width - 5) / 68, (self.height - 1) / 26

        def put(x, y, glyph, tone, shade=1):
            x = round(self.center + (x-36)*sx)
            y = round(y*sy)
            if 0 <= x < self.width and 0 <= y < self.height:
                grid[y][x] = (glyph, tone, shade)

        trunk_mask = set()
        # Resolve the centerline to rows first, avoiding overdraw and jagged bark.
        trunk_rows = {}
        for x, y, birth, radius, branch in self.wood:
            if birth > age:
                continue
            if not branch:
                trunk_rows[round(y*sy)] = (x, y, birth, radius)
                continue
        for row, (x, y, birth, radius) in trunk_rows.items():
            previous = trunk_rows.get(row-1, (x, y, birth, radius))[0]
            slope = previous-x
            stroke = '╱' if slope > .24 else '╲' if slope < -.24 else '│'
            half = round(radius * sx * min(1, max(0, age-birth)/.32))
            if half:
                put(x-half/sx, y, stroke, 'bark', .78)
                for offset in range(-half+1, half):
                    put(x+offset/sx, y, '│' if (row+offset)%4 == 0 else ' ', 'bark', .55)
                put(x+half/sx, y, stroke, 'bark', 1.18)
            else:
                put(x, y, stroke, 'bark', 1)
            cx = round(self.center + (x-36)*sx)
            trunk_mask.update((cx+offset, row) for offset in range(-half, half+1))
        # A branch's contour follows its actual local direction in screen cells.
        prior = None
        for x, y, birth, radius, branch in self.wood:
            if not branch or birth > age:
                prior = None
                continue
            if prior is not None:
                dx, dy = (x-prior[0])*sx, (y-prior[1])*sy
                glyph = '─' if abs(dy) < abs(dx)*.35 else '╱' if dx*dy < 0 else '╲'
                screen = (round(self.center + (x-36)*sx), round(y*sy))
                if screen not in trunk_mask:
                    put(x, y, glyph, 'bark', .85)
            prior = (x, y)
        for x, y, birth, glyph, tone, shade in sorted(self.leaves, key=lambda leaf: leaf[2]):
            if birth <= age:
                put(x, y, '·' if age-birth < .035 else glyph, tone, shade)
        # Cotyledons remain at the foot until the first true branches develop.
        if age < .23:
            put(34.6, 24.7, '╲', 'primary', .9)
            put(37.4, 24.7, '╱', 'tertiary', .9)
            put(36, 26, '│', 'bark')
        elif age > .70:
            for x, glyph in ((33, '╱'), (39, '╲')):
                put(x, 26, glyph, 'bark', .65)
        return grid


DAY = 24 * 60 * 60


def load_tree(state_home, now=None, new=False, seed=None):
    """Serialize first planting across terminals; keep mature trees until --new."""
    import fcntl
    import tempfile
    now = time.time() if now is None else now
    directory = Path(state_home) / 'terminal-bonsai'
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = directory / 'tree.json'
    with (directory / 'tree.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not new:
            try:
                data = json.loads(path.read_text())
                if (data.get('version') == 2 and type(data.get('seed')) is int
                        and type(data.get('planted')) in (int, float)
                        and math.isfinite(data['planted']) and data['planted'] >= 0):
                    return data
            except (OSError, ValueError, AttributeError):
                pass
        data = dict(version=2, seed=seed if seed is not None else random.SystemRandom().getrandbits(64), planted=now)
        fd, temporary = tempfile.mkstemp(prefix='.tree-', dir=directory)
        try:
            with os.fdopen(fd, 'w') as stream:
                json.dump(data, stream)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        return data


def age_at(data, now=None):
    return max(0, min(1, ((time.time() if now is None else now) - data['planted']) / DAY))


def ink(palette, tone, shade):
    value = '#96704f' if tone == 'bark' else palette.get(tone, PALETTE['outline'])
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        value = PALETTE.get(tone, PALETTE['outline'])
    return '\033[38;2;{};{};{}m'.format(*(max(0, min(255, round(int(value[i:i+2], 16) * shade))) for i in (1, 3, 5)))


def render(tree, age, palette, columns, plain=False):
    width = tree.width
    margin = ' ' * max(0, (columns - width - 2) // 2)
    def paint(text, tone='outline', shade=.65):
        return text if plain else ink(palette, tone, shade) + text + RESET
    def row(text):
        return margin + paint('║') + text + paint('║')
    lines = [margin + paint('╔' + '═' * width + '╗', 'primary')]
    for cells in tree.cells(age):
        text, previous = [], None
        for glyph, tone, shade in cells:
            if not plain and (tone, shade) != previous:
                text.append(ink(palette, tone, shade))
                previous = tone, shade
            text.append(glyph)
        lines.append(row(''.join(text) + ('' if plain else RESET)))
    # Low glazed ceramic planter, centered beneath the root flare.
    motif = ('─◇─┬' if int(tree.phase * 10) % 2 else '─┬─◇')
    band = (motif * 5)[:17]
    for pot in ('╭─────────────────╮', '╲' + band + '╱', ' ╰───────────────╯ '):
        left = tree.center - len(pot) // 2
        lines.append(row(' ' * left + paint(pot, 'secondary', .9) + ' ' * (width - left - len(pot))))
    label = ('seedling' if age < .12 else 'shaping wood' if age < .45
             else 'unfurling leaves' if age < .85 else 'finishing canopy' if age < 1 else 'mature bonsai')
    caption = f'{label} · {age * 24:.1f}/24h'
    if len(caption) > width:
        caption = f'{age * 24:.1f}/24h'
    lines.append(row(paint(caption.center(width), 'outline', .65)))
    lines.append(margin + paint('╚' + '═' * width + '╝', 'tertiary'))
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seed', type=int, help='Preview a reproducible tree (with --new: plant this seed)')
    parser.add_argument('--age', type=float, help='Preview maturity from 0 to 1; requires --seed')
    parser.add_argument('--new', action='store_true', help='Plant a fresh tree and restart its 24-hour growth')
    parser.add_argument('--live', action='store_true', help='Watch saved growth; Ctrl+C returns to the shell')
    parser.add_argument('--no-animation', action='store_true', help='Print the current growth once')
    parser.add_argument('--plain', action='store_true', help='Export the current tree without colors or screen controls')
    args = parser.parse_args()
    if args.age is not None and (args.seed is None or args.new or not 0 <= args.age <= 1):
        parser.error('--age requires --seed, must be between 0 and 1, and cannot be used with --new')
    if not args.plain and (not sys.stdout.isatty() or os.environ.get('TERM', 'dumb') == 'dumb'):
        return
    columns, rows = shutil.get_terminal_size()
    if columns < 36 or rows < 18:
        return
    palette = PALETTE.copy()
    try:
        data = json.loads((Path.home() / '.cache/rebos_shell/effective-palette.json').read_text())
        if isinstance(data, dict):
            palette.update(data)
    except (OSError, ValueError):
        pass
    preview = args.seed is not None and not args.new
    if preview:
        saved = dict(seed=args.seed, planted=0)
    else:
        try:
            saved = load_tree(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state',
                              new=args.new, seed=args.seed)
        except OSError as error:
            print(f'terminal-bonsai: cannot save growth: {error}', file=sys.stderr)
            return
    live = args.live and not (args.plain or args.no_animation or os.environ.get('REDUCE_MOTION') == '1')

    def picture():
        columns, rows = shutil.get_terminal_size()
        if columns < 36 or rows < 18:
            return 'Resize to at least 36 × 18 to see your bonsai.' if live else ''
        tree = Tree(min(72, columns - 8), min(26, rows - 8), saved['seed'])
        age = (1 if args.age is None else args.age) if preview else age_at(saved)
        return render(tree, age, palette, columns, args.plain)

    if not live:
        sys.stdout.write(picture() + '\n\n')
        return
    # A dedicated view owns its alternate screen. Ordinary greetings never
    # redraw, block the prompt, or share cursor ownership with a shell command.
    import signal
    def stop(signum, frame):
        raise KeyboardInterrupt
    previous = signal.signal(signal.SIGTERM, stop)
    try:
        sys.stdout.write('\033[?1049h\033[?25l')
        while True:
            sys.stdout.write('\033[H\033[2J' + picture())
            sys.stdout.flush()
            time.sleep(30)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write(RESET + '\033[?25h\033[?1049l')
        sys.stdout.flush()
        signal.signal(signal.SIGTERM, previous)


if __name__ == '__main__':
    main()
