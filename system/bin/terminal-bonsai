#!/usr/bin/env python3
"""Procedural, seed-to-canopy bonsai greeting. Python standard library only."""
import argparse
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import sys
import time

RESET = '\033[0m'
PALETTE = dict(primary='#ffb4a2', secondary='#e7bdb3', tertiary='#dac58d', outline='#a08c88')


class Tree:
    """Generate geometry once; age reveals connected growth, never rerolls it."""
    def __init__(self, width, height, seed=None):
        self.width, self.height = width, height
        self.rng = random.Random(seed)
        self.wood, self.leaves = [], []
        self.center = width // 2
        self.lean = self.rng.uniform(-.7, .7)
        self.phase = self.rng.uniform(0, math.tau)
        self.branch(self.center, height - 1, -math.pi / 2, height * .86, 0, .04, .53)

    def branch(self, x, y, angle, length, depth, birth, duration):
        rng = self.rng
        steps = max(3, int(length * 3))
        points = []
        for i in range(steps + 1):
            t = i / steps
            if i:
                # Horizontal cells are half as wide as vertical cells.
                angle += rng.uniform(-.10, .10)
                if depth == 0:
                    angle = -math.pi / 2 + self.lean + .32 * math.sin(t * 7 + self.phase)
                else:
                    angle += (-math.pi / 2 - angle) * .025
                x += math.cos(angle) * length / steps * 1.8
                y += math.sin(angle) * length / steps
            x = max(2, min(self.width - 3, x))
            y = max(1, min(self.height - 1, y))
            points.append((x, y, angle))
            self.wood.append((x, y, angle, birth + duration * t, depth, t))
        if depth < 3:
            forks = ( .28, .47, .65, .82) if depth == 0 else (.48, .85)
            side = rng.choice((-1, 1))
            for j, t in enumerate(forks):
                px, py, pa = points[int(t * steps)]
                direction = side * (-1 if j % 2 else 1)
                spread = rng.uniform(.65, 1.15)
                child_length = length * (rng.uniform(.32, .48) if depth == 0 else rng.uniform(.42, .64))
                self.branch(px, py, pa + direction * spread, child_length, depth + 1,
                            birth + duration * t, duration * .55)
        if depth >= 2:
            # Layered, elliptical foliage pads leave the interior branchwork exposed.
            for t in (.76, 1):
                px, py, _ = points[int(t * steps)]
                radius = rng.uniform(2.0, 3.8) if depth == 2 else rng.uniform(1.5, 2.8)
                for dy in range(-2, 3):
                    for dx in range(-4, 5):
                        distance = (dx / radius) ** 2 + (dy / (radius * .42)) ** 2
                        if distance < 1 and rng.random() > .15:
                            tone = 'tertiary' if dy < 0 and rng.random() < .6 else 'primary'
                            glyph = rng.choice('·˙•') if distance > .65 else rng.choice('•❧✦')
                            self.leaves.append((round(px + dx), round(py + dy),
                                                min(.98, birth + duration * t + .10 + rng.random() * .13),
                                                glyph, tone, .55 if dy > 0 else .95))

    def cells(self, age):
        grid = [[(' ', 'outline', 1) for _ in range(self.width)] for _ in range(self.height)]
        def put(x, y, glyph, tone, shade=1):
            if 0 <= x < self.width and 0 <= y < self.height:
                grid[y][x] = (glyph, tone, shade)
        for x, y, angle, birth, depth, t in self.wood:
            if birth > age:
                continue
            x, y = round(x), round(y)
            dx = math.cos(angle)
            glyph = '│' if abs(dx) < .22 else '╱' if dx > 0 else '╲'
            # Old lower wood gains a flared contour while fine twigs stay hairline.
            thickness = (1 - t) * max(0, age - .25) * 3 if depth == 0 else 0
            if thickness > .8:
                half = max(1, round(thickness))
                put(x - half, y, glyph, 'bark', .85)
                for offset in range(-half + 1, half):
                    put(x + offset, y, '│' if (offset + y) % 3 == 0 else '░', 'bark', .65)
                put(x + half, y, glyph, 'bark', 1.2)
            else:
                put(x, y, glyph, 'bark', 1.15 if depth > 1 else .9)
        for x, y, birth, glyph, tone, shade in self.leaves:
            if birth <= age:
                put(x, y, glyph if age - birth > .08 else '·', tone, shade)
        if age < .18:
            put(self.center - 1, self.height - 2, '╲', 'primary')
            put(self.center + 1, self.height - 2, '╱', 'tertiary')
        return grid


def ink(palette, tone, shade):
    value = '#96704f' if tone == 'bark' else palette.get(tone, PALETTE['outline'])
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        value = PALETTE.get(tone, PALETTE['outline'])
    return '\033[38;2;{};{};{}m'.format(*(max(0, min(255, round(int(value[i:i+2], 16) * shade))) for i in (1, 3, 5)))


def render(tree, age, palette, columns, plain=False):
    width = tree.width
    margin = ' ' * max(0, (columns - width - 2) // 2)
    def paint(text, tone='outline', shade=.65):
        return text if plain else ink(palette, tone, shade) + text + RESET
    def row(text):
        return margin + paint('║') + text + paint('║')
    lines = [margin + paint('╔' + '═' * width + '╗', 'primary')]
    for cells in tree.cells(age):
        text, previous = [], None
        for glyph, tone, shade in cells:
            if not plain and (tone, shade) != previous:
                text.append(ink(palette, tone, shade))
                previous = tone, shade
            text.append(glyph)
        lines.append(row(''.join(text) + ('' if plain else RESET)))
    # Low glazed ceramic planter, centered beneath the root flare.
    motif = ('─◇─┬' if int(tree.phase * 10) % 2 else '─┬─◇')
    band = (motif * 5)[:17]
    for pot in ('╭─────────────────╮', '╲' + band + '╱', ' ╰───────────────╯ '):
        left = tree.center - len(pot) // 2
        lines.append(row(' ' * left + paint(pot, 'secondary', .9) + ' ' * (width - left - len(pot))))
    lines.append(margin + paint('╚' + '═' * width + '╝', 'tertiary'))
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seed', type=int, help='Replay a particular tree')
    parser.add_argument('--no-animation', action='store_true', help='Show the mature tree immediately')
    parser.add_argument('--plain', action='store_true', help='Print an uncolored mature tree, including to a pipe')
    args = parser.parse_args()
    if not args.plain and (not sys.stdout.isatty() or os.environ.get('TERM', 'dumb') == 'dumb'):
        return
    columns, rows = shutil.get_terminal_size()
    if columns < 36 or rows < 18:
        return
    palette = PALETTE.copy()
    try:
        data = json.loads((Path.home() / '.cache/rebos_shell/effective-palette.json').read_text())
        if isinstance(data, dict):
            palette.update(data)
    except (OSError, ValueError):
        pass
    tree = Tree(min(64, columns - 8), min(22, rows - 9), args.seed)
    animate = not (args.no_animation or args.plain or os.environ.get('REDUCE_MOTION') == '1')
    frames = 30 if animate else 1
    # Reserve normal scrollback rows first; redraw only our own area. Never read
    # keyboard input or enter an alternate screen, so early typing is preserved.
    height = tree.height + 5
    try:
        if animate:
            sys.stdout.write('\n' * height + f'\033[{height}A')
        for frame in range(frames):
            age = frame / (frames - 1) if animate else 1
            sys.stdout.write(render(tree, age, palette, columns, args.plain) + '\n')
            sys.stdout.flush()
            if frame < frames - 1:
                time.sleep(1.8 / (frames - 1))
                sys.stdout.write(f'\033[{height}A')
    except KeyboardInterrupt:
        sys.stdout.write('\n')
    finally:
        if not args.plain:
            sys.stdout.write(RESET)
        sys.stdout.write('\n')


if __name__ == '__main__':
    main()
