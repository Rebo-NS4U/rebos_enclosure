#!/usr/bin/env python3
"""Sculpted terminal bonsai, rendered with transparent half-block cells."""
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import sys

RESET = '\033[0m'
DEFAULT_PALETTE = {'primary': '#ffb4a2', 'secondary': '#e7bdb3', 'tertiary': '#dac58d'}


def rgb(value, fallback):
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        value = fallback
    return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))


def mix(a, b, weight):
    return tuple(round(x * (1 - weight) + y * weight) for x, y in zip(a, b))


def render(columns, rows, seed=0, palette=None):
    """Return a bounded drawing; no terminal controls other than SGR colors."""
    if columns < 36 or rows < 18:
        return ''
    palette = palette if isinstance(palette, dict) else {}
    accent = rgb(palette.get('tertiary'), DEFAULT_PALETTE['tertiary'])
    glaze = rgb(palette.get('secondary'), DEFAULT_PALETTE['secondary'])
    # Half a character row is approximately one character wide. Work in a
    # square-pixel model, then sample directly at the terminal's resolution.
    width = min(72, columns - 4, (rows - 3) * 3)
    height = min(52, (rows - 3) * 2)
    pixels = [[None] * width for _ in range(height)]
    rng = random.Random(seed)

    def paint(shape, shade):
        for y in range(height):
            py = (y + .5) * 96 / height
            for x in range(width):
                px = (x + .5) * 128 / width
                if shape(px, py):
                    pixels[y][x] = shade(px, py)

    def ellipse(cx, cy, rx, ry, shade):
        # Restrict curve stamps to their bounds so a greeting starts quickly.
        for y in range(max(0, math.floor((cy - ry) * height / 96)), min(height, math.ceil((cy + ry) * height / 96))):
            py = (y + .5) * 96 / height
            for x in range(max(0, math.floor((cx - rx) * width / 128)), min(width, math.ceil((cx + rx) * width / 128))):
                px = (x + .5) * 128 / width
                if ((px - cx) / rx) ** 2 + ((py - cy) / ry) ** 2 <= 1:
                    pixels[y][x] = shade(px, py)

    def bark(x, y):
        # Long, winding ridges, lit from the upper left. No repeating glyphs.
        grain = math.sin(x * 1.7 + math.sin(y * .13) * 2.2)
        light = .43 + .23 * grain + .10 * math.sin(x * .57 + y * .09)
        return mix((66, 43, 29), (166, 123, 78), max(0, min(1, light)))

    def limb(points, start, end):
        # Cubic curves keep taper and curvature continuous into each fork.
        for i in range(121):
            t = i / 120
            u = 1 - t
            x = u**3 * points[0][0] + 3*u*u*t*points[1][0] + 3*u*t*t*points[2][0] + t**3*points[3][0]
            y = u**3 * points[0][1] + 3*u*u*t*points[1][1] + 3*u*t*t*points[2][1] + t**3*points[3][1]
            radius = start * u + end * t
            ellipse(x, y, radius, radius, bark)

    # An asymmetric, S-shaped trunk, with branches supporting each foliage pad.
    limb(((64, 79), (43, 64), (82, 44), (64, 16)), 7, 1.5)
    for points, thick in (
        (((58, 66), (48, 60), (35, 58), (25, 47)), 3.3),
        (((60, 60), (76, 62), (91, 58), (100, 49)), 3.2),
        (((66, 46), (52, 45), (37, 40), (32, 31)), 2.8),
        (((69, 41), (81, 40), (90, 36), (94, 29)), 2.5),
        (((68, 30), (60, 28), (53, 24), (50, 19)), 2.1),
    ):
        limb(points, thick, .7)
    # Roots spread over a low mound rather than ending at a floating stem.
    ellipse(64, 80, 22, 3, lambda x, y: (53, 57, 34))
    for tip in (44, 52, 76, 84):
        limb(((64, 74), (62, 77), ((tip + 64) / 2, 79), (tip, 81)), 2.6, .6)

    leafbase = mix((76, 111, 61), accent, .22)
    # Each pad is a union of small lobes, with a shaded underside and fine
    # leaves. The gaps between pads expose the branch structure.
    for cx, cy, rx, ry in ((33, 47, 23, 8), (94, 49, 23, 9),
                           (38, 32, 24, 9), (87, 30, 23, 9),
                           (58, 18, 24, 9), (67, 9, 14, 6)):
        lobes = [(cx + rx * offset, cy + rng.uniform(-2, 1), rx * .49, ry * rng.uniform(.73, 1.0))
                 for offset in (-.59, -.23, .2, .58)]
        def inside(x, y):
            return any(((x-a)/c)**2 + ((y-b)/d)**2 <= 1 for a,b,c,d in lobes)
        def foliage(x, y):
            depth = max(0, min(1, (y - cy + ry) / (2 * ry)))
            fleck = ((int(x * 3) * 73 + int(y * 3) * 37 + seed * 19) % 101) / 100
            tone = mix(mix(leafbase, (158, 174, 96), .48), (29, 57, 39), depth * .85)
            return mix(tone, (190, 193, 119), .28 if fleck > .79 else 0)
        paint(inside, foliage)

    # Quiet ceramic bowl: narrow lip, curved shoulders, a shaded base and feet.
    def ceramic(x, y):
        light = max(0, 1 - abs(x - 56) / 34)
        return mix(mix(glaze, (32, 39, 44), .75), mix(glaze, (164, 184, 184), .35), light * .65)
    paint(lambda x,y: 82 <= y <= 91 and abs(x - 64) <= 22 - (y - 82) * .65, ceramic)
    ellipse(64, 82, 24, 1.5, lambda x,y: mix(glaze, (129, 152, 151), .55))
    paint(lambda x,y: 91 < y <= 93 and (49 <= x <= 54 or 74 <= x <= 79), lambda x,y: mix(glaze, (29, 37, 41), .8))

    margin = ' ' * ((columns - width) // 2)
    output = ['']
    for y in range(0, height, 2):
        parts = [margin]
        previous = None
        for x in range(width):
            top = pixels[y][x]
            bottom = pixels[y + 1][x] if y + 1 < height else None
            if top is None and bottom is None:
                ink, glyph = RESET, ' '
            elif top is None or bottom is None:
                ink = '\033[49m\033[38;2;{};{};{}m'.format(*(top or bottom))
                glyph = '▀' if top else '▄'
            else:
                ink = '\033[38;2;{};{};{}m\033[48;2;{};{};{}m'.format(*top, *bottom)
                glyph = '▀'
            if ink != previous:
                parts.append(ink)
                previous = ink
            parts.append(glyph)
        output.append(''.join(parts) + RESET)
    return '\n'.join(output) + '\n\n'


def main():
    if not sys.stdout.isatty() or os.environ.get('TERM', 'dumb') == 'dumb':
        return
    palette = {}
    try:
        palette = json.loads((Path.home() / '.cache/rebos_shell/effective-palette.json').read_text())
    except (OSError, ValueError):
        pass
    columns, rows = shutil.get_terminal_size()
    sys.stdout.write(render(columns, rows, random.randrange(4), palette))


if __name__ == '__main__':
    main()
