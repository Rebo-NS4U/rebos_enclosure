#!/usr/bin/env python3
"""A persistent, additive terminal bonsai. Standard library terminal rendering."""

import argparse
import fcntl
import functools
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import sys
import time


def valid_palette(value):
    return (
        isinstance(value, list)
        and len(value) == 3
        and all(
            isinstance(c, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", c) for c in value
        )
    )


def wallpaper_palette():
    """Read the current desktop theme for foliage, ceramics and framing."""
    fallback = ["#85b470", "#b8ce93", "#67bca3"]
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    try:
        data = json.loads((cache / "rebos_shell/effective-palette.json").read_text())
        accents = [data.get(key) for key in ("primary", "secondary", "tertiary")]
        return accents if valid_palette(accents) else fallback
    except OSError, ValueError, AttributeError:
        return fallback


def preview_identity(seed):
    directory = (
        Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        / "bonsai-grow"
    )
    try:
        state = json.loads((directory / "tree.json").read_text())
        saved_seed = state.get("seed")
        if type(saved_seed) is int:
            return saved_seed if seed is None else seed, wallpaper_palette()
    except OSError, ValueError, AttributeError:
        pass
    return 42 if seed is None else seed, wallpaper_palette()


def age():
    directory = (
        Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        / "bonsai-grow"
    )
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = directory / "tree.json"
        if path.exists():
            state = json.loads(path.read_text())
        else:
            state = {
                "born": time.time(),
                "opens": 0,
                "seed": random.SystemRandom().randrange(2**31),
            }
        if (
            type(state.get("born")) not in (float, int)
            or type(state.get("opens")) is not int
            or state["opens"] < 0
            or type(state.get("seed")) is not int
        ):
            raise ValueError("Invalid bonsai state")
        # Older trees have no color snapshot; adopt the current wallpaper once.
        if "palette" not in state:
            state["palette"] = wallpaper_palette()
        if not valid_palette(state["palette"]):
            raise ValueError("Invalid saved palette")
        state["opens"] += 1
        temporary = directory / "tree.json.tmp"
        temporary.write_text(json.dumps(state) + "\n")
        temporary.replace(path)
    return (
        max(0, time.time() - state["born"]) / 86400 + (state["opens"] - 1) / 12,
        state["seed"],
        state["palette"],
    )


def trunk_path(seed, style="informal"):
    """Seeded, smoothly joined bends; age never changes established wood."""
    rng = random.Random(f"{seed}:trunk")
    if style == "informal":
        pattern, side = growth_pattern(seed)
        amplitude = (
            rng.uniform(2, 3.5)
            if pattern in ("forked", "broom", "old_oak")
            else rng.uniform(4.5, 5.5)
            if pattern in ("recurved", "slant")
            else rng.uniform(6, 6.5)
            if pattern == "twisted_juniper"
            else rng.uniform(4.5, 8)
        )
        phase = rng.uniform(0.8, 1.15)
        path = []
        for depth in range(15):
            t = depth / 14
            if pattern == "upright":
                bend = 0.3 * math.sin(t * math.pi * phase) + 0.12 * t
            elif pattern == "slant":
                bend = t**0.85
            elif pattern == "bowed":
                bend = math.sin(t * math.pi * 0.8)
            elif pattern == "old_oak":
                bend = 0.2 * math.sin(t * math.pi * phase) + 0.08 * t
            elif pattern == "twisted_juniper":
                bend = 0.6 * math.sin(t * math.pi) - 0.12 * t
            elif pattern == "broom":
                bend = 0.25 * math.sin(t * math.pi * phase)
            elif pattern == "forked":
                bend = 0.35 * math.sin(t * math.pi * 0.85)
            else:
                bend = math.sin(t * math.pi * 1.2) * 0.6 + 0.15 * t
            x = 27 + side * amplitude * bend
            path.append(
                x if not path else max(path[-1] - 0.95, min(path[-1] + 0.95, x))
            )
        return path
    lean = rng.uniform(-5, 5)
    if style == "slant":
        lean = (-1 if lean < 0 else 1) * rng.uniform(4, 6)
    depths = [0, *sorted(rng.sample(range(2, 13), rng.randint(2, 4))), 14]
    knots = [(0, 27)]
    for depth in depths[1:-1]:
        if style == "slant":
            center = 27 + lean * (depth / 14) ** 0.75 + rng.uniform(-0.5, 0.5)
        else:
            center = 27 + lean * depth / 14 + rng.uniform(-3.5, 3.5)
        knots.append((depth, center))
    knots.append((14, 27 + lean))
    path = []
    segment = 0
    for depth in range(15):
        while depth > knots[segment + 1][0]:
            segment += 1
        d0, x0 = knots[segment]
        d1, x1 = knots[segment + 1]
        t = (depth - d0) / (d1 - d0)
        center = x0 + (x1 - x0) * t * t * (3 - 2 * t)
        if path:
            # Keep neighboring rows connected even on strongly curved trunks.
            center = max(path[-1] - 0.9, min(path[-1] + 0.9, center))
        path.append(center)
    return path


def cascade_path(seed):
    """Rise from the pot, curve outward, then descend beyond its rim."""
    rng = random.Random(f"{seed}:cascade")
    controls = (
        (27, 18),
        (27 + rng.uniform(-1, 1), 7 + rng.uniform(-1, 1)),
        (42 + rng.uniform(-1, 1), 7 + rng.uniform(-1, 1)),
        (47, 17),
    )
    path = []
    for depth in range(15):
        t = depth / 14
        weights = ((1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t * t, t**3)
        path.append(
            tuple(
                sum(p[axis] * w for p, w in zip(controls, weights)) for axis in (0, 1)
            )
        )
    return path


def cascade_stem(days, seed):
    path = cascade_path(seed)
    height = min(len(path), 2 + int(days * 0.7))
    wood = set()
    for depth in range(height - 1):
        x0, y0 = path[depth]
        x1, y1 = path[depth + 1]
        steps = max(1, math.ceil(math.hypot(x1 - x0, y1 - y0) * 3))
        for step in range(steps + 1):
            t = step / steps
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            age = max(0, days - (depth + t) * 0.85)
            radius = min(1.8, age / 22, (height - 1 - depth - t) * 0.7)
            wood.add((round(x), round(y)))
            for cy in range(math.floor(y - radius), math.ceil(y + radius) + 1):
                for cx in range(
                    math.floor(x - radius * 1.4), math.ceil(x + radius * 1.4) + 1
                ):
                    if ((cx - x) / 1.4) ** 2 + (cy - y) ** 2 <= radius**2:
                        wood.add((cx, cy))
    cells = []
    for x, y in sorted(wood):
        interior = all(
            p in wood for p in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1))
        )
        if interior:
            glyph, ink = ("╵" if (x * 3 + y) % 9 == 0 else " "), "bark"
        else:
            nearest = min(
                range(height),
                key=lambda d: (path[d][0] - x) ** 2 + (path[d][1] - y) ** 2,
            )
            before, after = (
                path[max(0, nearest - 1)],
                path[min(height - 1, nearest + 1)],
            )
            dx, dy = after[0] - before[0], after[1] - before[1]
            glyph = (
                "│"
                if abs(dx) < abs(dy) * 0.6
                else "─"
                if abs(dy) < abs(dx) * 0.35
                else "╱"
                if dx * dy < 0
                else "╲"
            )
            ink = "wood"
        cells.append((x, y, 0, glyph, ink))
    return cells


def stem(days, seed=42, style="informal"):
    """A tapered trunk: length, girth, roots and bark develop at different rates."""
    if style == "semi-cascade":
        return cascade_stem(days, seed)
    centers = trunk_path(seed, style)
    height = min(len(centers), 2 + int(days * 0.7))
    if style == "informal":
        limit = {"broom": 7, "old_oak": 8}.get(growth_pattern(seed)[0], 15)
        height = min(height, limit)
    contours = []
    for depth in range(height):
        # Older wood thickens first; the growing tip always stays narrow.
        girth = min(6, max(0, int((days - depth * 0.85) / 5)))
        if style == "informal":
            # Give the young stem a visible body below its tapered tip.
            starter_girth = 2 if depth < height - 2 else 1 if depth < height - 1 else 0
            girth = max(girth, starter_girth)
            girth = min(girth, max(0, round(4 * (1 - depth / 15) ** 0.9)))
        girth = min(girth, (height - depth - 1) * 2)
        if depth == 0 and days >= 14:
            girth += 2
        left = round(centers[depth] - girth / 2)
        contours.append((left, left + girth))
    cells = []
    for depth, (left, right) in enumerate(contours):
        upper = contours[min(depth + 1, height - 1)]
        y = 18 - depth
        if left == right:
            below = centers[max(0, depth - 1)]
            glyph = (
                "╱"
                if centers[depth] > below + 0.3
                else "╲"
                if centers[depth] < below - 0.3
                else "│"
            )
            cells.append((left, y, 0, glyph, "wood"))
            continue
        for x in range(left, right + 1):
            if x == left:
                glyph = "╱" if upper[0] > left else "╲" if upper[0] < left else "│"
                ink = "wood"
            elif x == right:
                glyph = "╲" if upper[1] < right else "╱" if upper[1] > right else "│"
                ink = "wood"
            else:
                # Quiet vertical grain and a few scars emerge on older bark.
                glyph = (
                    "│"
                    if (x + depth * 3) % 7 == 0
                    else "╵"
                    if (x * 7 + depth) % 13 == 0
                    else " "
                )
                ink = "bark"
                if style == "informal":
                    grain = random.Random(f"{seed}:bark:{depth}:{x}")
                    # Grain follows the trunk tangent instead of random slashes.
                    turn = centers[min(depth + 1, height - 1)] - centers[depth]
                    grain_stroke = "╱" if turn > 0.2 else "╲" if turn < -0.2 else "╎"
                    glyph = grain.choices(("░", "▒", grain_stroke), (3, 6, 1))[0]
            cells.append((x, y, 0, glyph, ink))
    # A small growing tip is visible even during the bare-stem phase.
    tip = "╮" if centers[height - 1] >= centers[max(0, height - 2)] else "╭"
    if days < 22:
        cells.append((round(centers[height - 1]), 18 - height, 0, tip, "woodlight"))
    return cells


def growth_pattern(seed):
    """Choose a whole-tree habit, not just jitter around the same silhouette."""
    designed = random.Random(f"{seed}:oak-juniper")
    if designed.random() < 0.25:
        return designed.choice(("old_oak", "twisted_juniper")), designed.choice((-1, 1))
    extra = random.Random(f"{seed}:extra-habit")
    if extra.random() < 0.28:
        keep_broom = extra.choice((True, False))
        direction = extra.choice((-1, 1))
        if keep_broom:
            return "broom", direction
    rng = random.Random(f"{seed}:habit")
    return rng.choice(("upright", "slant", "bowed", "forked", "recurved")), rng.choice(
        (-1, 1)
    )


def branch_layout(seed):
    """Share each specimen's varied limb plan with its starter leaves."""
    rng = random.Random(f"{seed}:limb-layout")
    pattern, side = growth_pattern(seed)
    centers = trunk_path(seed)
    if pattern in ("old_oak", "twisted_juniper"):
        shift = (centers[-1] - 27) * 0.6
        result = []
        if pattern == "old_oak":
            # A low massive fork, uneven lateral limbs and a rounded apex.
            controls = (
                (4, side * rng.uniform(8, 10.5), rng.uniform(7, 8.5)),
                (5, -side * rng.uniform(7.5, 10), rng.uniform(6, 7.5)),
                (7, rng.uniform(-1, 1), rng.uniform(3, 4)),
            )
        else:
            # Three separated pads follow the main bend and its returning leader.
            controls = [
                (7, side * rng.uniform(6, 7.5), rng.uniform(8, 8.7)),
                (10, -side * rng.uniform(5, 7), rng.uniform(7, 7.6)),
                (14, side * rng.uniform(1, 2.5), rng.uniform(2.8, 3.5)),
            ]
            if rng.random() < 0.4:
                controls.append((9, side * rng.uniform(2.5, 4), rng.uniform(6, 6.5)))
        for index, (depth, reach, y) in enumerate(controls):
            born = max((depth - 1) / 0.7, 8 + index * 2)
            result.append((depth, centers[depth] + reach - shift, y, born))
        return result
    if pattern == "broom":
        shift = (centers[-1] - 27) * 0.6
        result = []
        controls = (
            (5, side * rng.uniform(7, 9), rng.uniform(5, 6.5)),
            (6, -side * rng.uniform(7, 9), rng.uniform(5.5, 7)),
            (6, side * rng.uniform(0.5, 2), rng.uniform(2.8, 3.5)),
        )
        for index, (depth, reach, y) in enumerate(controls):
            born = max((depth - 1) / 0.7, 8 + index * 0.7)
            result.append((depth, centers[depth] + reach - shift, y, born))
        return result
    if pattern == "forked":
        # Two rising scaffold arms make an open Y-shaped crown above a stout base.
        shift = (centers[-1] - 27) * 0.6
        result = []
        for index, direction in enumerate((side, -side)):
            depth = rng.choice((5, 6, 7))
            reach = rng.uniform(7.5, 10.5)
            x = centers[depth] + direction * reach
            result.append(
                (
                    depth,
                    x - shift,
                    rng.uniform(4.5, 5.6) if index == 0 else rng.uniform(6, 7.2),
                    max((depth - 1) / 0.7, 11 + index * 0.6),
                )
            )
        depth = rng.choice((8, 9))
        result.append(
            (
                depth,
                centers[depth] - shift + side * rng.uniform(1.5, 3),
                2.8,
                max((depth - 1) / 0.7, 14),
            )
        )
        return result
    attachments = sorted(rng.sample(range(4, 11), 3))
    if pattern == "windswept":
        # Keep a visible low limb instead of bunching every pad at the apex.
        attachments = [rng.randint(4, 5), rng.randint(7, 8), rng.randint(10, 11)]
        sides = (side, side, side)
    elif pattern == "slant":
        attachments = [rng.randint(5, 6), rng.randint(8, 9), rng.randint(10, 11)]
        sides = (-side, side, -side)
    elif pattern == "bowed":
        sides = (-side, side, side)
    elif pattern in ("upright", "recurved"):
        attachments = [rng.randint(5, 6), rng.randint(8, 9), rng.randint(10, 11)]
        sides = (side, -side, -side)
    else:
        sides = (side, side, -side) if rng.random() < 0.5 else (-side, side, -side)
    result = []
    for index, (depth, direction) in enumerate(zip(attachments, sides)):
        reach = rng.uniform(8, 14) if index < 2 else rng.uniform(6, 11)
        if pattern in ("upright", "recurved"):
            reach = min(reach, rng.uniform(7, 9))
        if pattern == "slant":
            reach = min(reach, rng.uniform(6, 8))
        if pattern == "windswept":
            reach = min(reach, 8.5 - depth * 0.35)
        x = max(11, min(44, centers[depth] + direction * reach))
        y = max(
            3.5,
            18 - depth - max(2, abs(x - centers[depth]) * 0.3) - rng.uniform(0, 0.6),
        )
        born = max((depth - 1) / 0.7, 11 + index * 2 + rng.uniform(-1, 1))
        # The renderer applies the crown offset once to every limb.
        result.append((depth, x - (centers[-1] - 27) * 0.6, y, born))
    for depth in sorted(rng.sample(range(11, 15), rng.randint(1, 3))):
        direction = side if pattern == "windswept" else rng.choice((-1, 1))
        x = centers[depth] + direction * rng.uniform(
            2, 4 if pattern == "windswept" else 7
        )
        result.append(
            (
                depth,
                x - (centers[-1] - 27) * 0.6,
                rng.uniform(2, 3.5),
                max((depth - 1) / 0.7, 17),
            )
        )
    return result


def juvenile_foliage(days, seed):
    """Leafy node pairs unfold along the young leader, then yield to its crown."""
    centers = trunk_path(seed, "informal")
    height = min(len(centers), 2 + int(days * 0.7))
    cells = []
    # The original pair follows the leader until the first limb attachments
    # establish, then travels outward on those limbs as their tips extend.
    primaries = [branch for branch in branch_graph(seed) if branch["parent"] is None]
    for cohort, branch in enumerate(primaries[:2]):
        attachment = round(18 - branch["start"][1])
        tx, ty = branch["end"]
        branch_born = branch["born"]
        depth = min(height - 1, attachment)
        born, age = 0, days
        x, y = round(centers[depth]), 18 - depth
        length = math.hypot(tx - x, ty - y)
        progress = min(1, max(2 / length, (days + 1 - branch_born) / (length * 0.55)))
        tip_x = round(x + (tx - x) * progress)
        tip_y = round(
            y + (ty - y) * progress - math.sin(progress * math.pi) * branch["curve"]
        )
        side = 1 if tx >= x else -1
        tone = (cohort + (side > 0)) % 3
        leaves = []
        for index, (dx, dy, delay) in enumerate(((1, 0, 0), (0, -1, 2))):
            rng = random.Random(f"{seed}:juvenile:{cohort}:{side}:{index}")
            shed = min(29, 24 + cohort * 1.5 + rng.uniform(0, 2))
            if age < delay or days >= shed:
                continue
            unfold = age - delay
            glyph = "·" if unfold < 0.5 else "•" if unfold < 2.5 else "●"
            tone = (cohort + (side > 0)) % 3
            shade = 2 if dy < 0 else 1
            leaves.append(
                (
                    tip_x + side * dx,
                    tip_y + dy,
                    born + delay,
                    glyph,
                    f"leaf{tone * 3 + shade}",
                )
            )
        if not leaves:
            continue
        steps = max(abs(tip_x - x), abs(tip_y - y), 1)
        path = []
        for step in range(1, steps + 1):
            t = step / steps
            point = (round(x + (tip_x - x) * t), round(y + (tip_y - y) * t))
            if path and point == path[-1]:
                continue
            path.append(point)
        previous_y = y
        for index, (sx, sy) in enumerate(path):
            is_tip = index == len(path) - 1
            glyph = ("╱" if side > 0 else "╲") if sy < previous_y else "─"
            ink = f"shoot_tip{tone:d}" if is_tip else f"shoot_mid{tone:d}"
            cells.append((sx, sy, born, glyph, ink))
            previous_y = sy
        cells.extend(leaves)
    # No temporary woody spurs remain after the juvenile leaves retire.
    return cells if days < 29 else []


def branch_point(branch, t):
    x, y = branch["start"]
    tx, ty = branch["end"]
    return (
        x + (tx - x) * t,
        y + (ty - y) * t - math.sin(t * math.pi) * branch["curve"],
    )


@functools.lru_cache(maxsize=64)
def branch_graph(seed):
    """A rooted hierarchy: uneven secondary forks inherit their parent's path."""
    rng = random.Random(f"{seed}:branch-graph")
    jitter = random.Random(seed)
    centers = trunk_path(seed)
    shift = (centers[-1] - 27) * 0.6
    habit, wind = growth_pattern(seed)
    branches = []
    layout = branch_layout(seed)
    directions = {
        1 if x + shift >= centers[depth] else -1 for depth, x, y, born in layout[:3]
    }
    one_sided = len(directions) == 1

    def add(
        start,
        end,
        born,
        width,
        parent=None,
        attachment=0,
        level=0,
        leader=False,
        lower=False,
    ):
        # Stagger crown-tip heights instead of clipping every twig to one roof.
        ceiling = rng.uniform(2.7, 3.1) if leader else rng.uniform(3.2, 5.2)
        if (
            habit
            in (
                "forked",
                "bowed",
                "upright",
                "recurved",
                "broom",
                "slant",
                "old_oak",
                "twisted_juniper",
            )
            and not lower
        ):
            # Keep the apex highest; outer branch pads sit progressively lower.
            crown_center = centers[-1]
            ceiling = max(ceiling, 2.8 + (abs(end[0] - crown_center) / 6) ** 1.4)
        end = (max(9, min(47, end[0])), max(ceiling, min(15 if lower else 14, end[1])))
        if level == 0 and not leader and not lower:
            # A shallow upper limb must stay short; it cannot become a shelf.
            run_limit = 1.5 + 3 * max(0, start[1] - end[1])
            end = (max(start[0] - run_limit, min(start[0] + run_limit, end[0])), end[1])
        if one_sided and not leader:
            # Taper the swept crown around the trunk instead of stacking
            # ever-longer horizontal forks against the outside edge.
            center = centers[min(14, max(0, round(18 - end[1])))]
            reach_limit = 3.5 + max(0, end[1] - 3) * 0.4
            end = (max(center - reach_limit, min(center + reach_limit, end[0])), end[1])
        length = math.hypot(end[0] - start[0], end[1] - start[1])
        branch = dict(
            start=start,
            end=end,
            born=born,
            width=width,
            parent=parent,
            attachment=attachment,
            length=length,
            curve=0
            if lower
            else rng.uniform(0.1, 0.25)
            if habit == "twisted_juniper"
            else rng.uniform(0.15, 0.7),
            level=level,
            leader=leader,
            lower=lower,
        )
        index = len(branches)
        branches.append(branch)
        if (
            lower
            or level >= (1 if one_sided or habit == "twisted_juniper" else 2)
            or length < 3
        ):
            return
        # One stronger continuation and a shorter lateral fork, at unequal nodes.
        fractions = (
            (rng.uniform(0.65, 0.85), rng.uniform(0.4, 0.65))
            if habit
            in (
                "forked",
                "bowed",
                "upright",
                "recurved",
                "broom",
                "slant",
                "old_oak",
                "twisted_juniper",
            )
            else (rng.uniform(0.7, 0.95), rng.uniform(0.4, 0.7))
        )
        if habit == "twisted_juniper":
            fractions = (rng.uniform(0.75, 0.85), rng.uniform(0.6, 0.7))
        for child, fraction in enumerate(fractions):
            origin = branch_point(branch, fraction)
            direction = 1 if end[0] >= start[0] else -1
            if child and habit != "windswept" and rng.random() < 0.55:
                direction *= -1
            if habit == "windswept":
                direction = wind
            reach = (
                length * rng.uniform(0.3, 0.48) * (1 if child == 0 else 0.6)
                if habit
                in (
                    "forked",
                    "bowed",
                    "upright",
                    "recurved",
                    "broom",
                    "slant",
                    "old_oak",
                    "twisted_juniper",
                )
                else length * rng.uniform(0.45, 0.65) * (1 if child == 0 else 0.6)
            )
            if habit == "twisted_juniper":
                direction = 1 if end[0] >= start[0] else -1
                reach = length * rng.uniform(0.16, 0.23)
            if leader:
                # The apex keeps reaching upward instead of becoming another
                # long horizontal, wind-driven limb.
                direction = wind if child == 0 else -wind
                reach = rng.uniform(1.2, 2.8)
            rise = (
                rng.uniform(0.3, 0.7)
                if habit == "twisted_juniper"
                else rng.uniform(1.8 if leader else 1.3, 3)
                * (1 if child == 0 else 0.65)
            )
            target = (origin[0] + direction * reach, origin[1] - rise)
            arrival = born + length * fraction * 0.55
            child_id = len(branches)
            add(
                origin,
                target,
                arrival + rng.uniform(0.3, 0.9),
                width * (0.58 if child == 0 else 0.38),
                index,
                fraction,
                level + 1,
                leader,
            )
            if habit == "twisted_juniper":
                branches[child_id]["pad_tip"] = child == 0

    for root_index, (depth, tx, ty, born) in enumerate(layout):
        tx += shift + jitter.uniform(-0.6, 0.6)
        ty += jitter.uniform(-0.3, 0.3)
        if one_sided and depth >= 11:
            tx = centers[depth] + (tx - centers[depth]) * 0.55
        width = max(0.55, 1.45 * (1 - depth / 24))
        if habit == "old_oak":
            width = (1.25, 1.1, 0.9)[root_index]
        add((centers[depth], 18 - depth), (tx, ty), born, width)
    if one_sided:
        # Give the swept lower body a distinct vertical continuation and crown.
        add((centers[11], 7), (centers[-1] + wind * 1.2, 2.7), 17, 0.85, leader=True)
    return branches


def natural_specimen(seed, days):
    """Render connected tapered wood and leaf sprays at its own terminal tips."""
    graph = branch_graph(seed)
    wood = {}
    strokes = {}
    centerline = set()
    for branch in graph:
        steps = max(1, math.ceil(branch["length"] * 2))
        for step in range(steps + 1):
            t = step / steps
            birth = branch["born"] + branch["length"] * t * 0.55
            if birth > days + 1:
                continue
            px, py = branch_point(branch, t)
            dx = branch["end"][0] - branch["start"][0]
            dy = (
                branch["end"][1]
                - branch["start"][1]
                - math.pi * math.cos(t * math.pi) * branch["curve"]
            )
            stroke = (
                "─"
                if abs(dy) < abs(dx) * 0.25
                else "│"
                if abs(dx) < abs(dy) * 0.5
                else "╱"
                if dx * dy < 0
                else "╲"
            )
            age = max(0, days - birth)
            radius = (
                min(
                    branch["width"],
                    (1.4 if branch["level"] == 0 else 0.4) + math.sqrt(age) * 0.25,
                )
                * (1 - t) ** 0.7
            )
            if branch["level"] == 0:
                radius = min(1.35, radius * 1.4)
            # Keep a rounded body through the limb, narrowing continuously
            # toward the twig rather than switching abruptly to a line.
            vertical_scale = 1.05 if branch["level"] == 0 else 1.6
            for y in range(math.floor(py - radius), math.ceil(py + radius) + 1):
                for x in range(math.floor(px - radius), math.ceil(px + radius) + 1):
                    if (x - px) ** 2 + ((y - py) * vertical_scale) ** 2 <= radius**2:
                        if birth <= wood.get((x, y), math.inf):
                            wood[(x, y)] = birth
                            strokes[(x, y)] = stroke
            key = (round(px), round(py))
            centerline.add(key)
            if birth <= wood.get(key, math.inf):
                wood[key] = birth
                strokes[key] = stroke
    cells = []
    for (x, y), birth in wood.items():
        interior = all(
            point in wood for point in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1))
        )
        filled = (x, y) not in centerline or interior
        glyph = "░" if filled else strokes[(x, y)]
        cells.append((x, y, birth, glyph, "bark" if filled else "wood"))
    parents = {branch["parent"] for branch in graph if branch["parent"] is not None}
    compact = any(branch["leader"] for branch in graph)
    for index, branch in enumerate(graph):
        if index in parents or (
            growth_pattern(seed)[0] == "twisted_juniper"
            and branch["parent"] is not None
            and not branch.get("pad_tip")
        ):
            continue
        cx, cy = branch["end"]
        rng = random.Random(f"{seed}:terminal:{index}")
        rx, ry = (
            (rng.uniform(2.6, 3.8), rng.uniform(1.3, 1.9))
            if compact
            else (rng.uniform(3.2, 5), rng.uniform(1.6, 2.4))
        )
        if branch.get("lower", False):
            rx, ry = rng.uniform(2.5, 3.3), rng.uniform(1, 1.35)
        if growth_pattern(seed)[0] == "twisted_juniper":
            rx, ry = (
                (rng.uniform(4.4, 5), rng.uniform(2, 2.2))
                if cy < 6.5
                else (rng.uniform(3.8, 4.8), rng.uniform(1.3, 1.65))
            )
        if growth_pattern(seed)[0] == "old_oak":
            rx, ry = (
                (rng.uniform(4.4, 5), rng.uniform(1.6, 2))
                if cy < 6.5
                else (rng.uniform(3.5, 4.6), rng.uniform(1.4, 1.9))
            )
        arrival = branch["born"] + branch["length"] * 0.55
        candidates = {}
        for y in range(max(1, math.floor(cy - ry)), min(18, math.ceil(cy + ry)) + 1):
            for x in range(
                max(2, math.floor(cx - rx)), min(54, math.ceil(cx + rx)) + 1
            ):
                distance = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2
                # Shared spray shapes make neighboring leaves read as clusters.
                # A scalloped rim and a small lower cleft leave airy branch gaps.
                nx, ny = (x - cx) / rx, (y - cy) / ry
                rim = (
                    1
                    + 0.10 * math.sin(nx * 9 + index)
                    + 0.06 * math.cos(ny * 8 - index)
                )
                cleft = ny > 0.25 and 0.25 < nx < 0.65 and distance > 0.38
                texture = random.Random(f"{seed}:leaf-cell:{index}:{x}:{y}")
                if (
                    distance > rim
                    or cleft
                    or texture.random() < (0.025 if distance < 0.7 else 0.14)
                ):
                    continue
                birth = arrival + 0.5 + math.hypot(x - cx, (y - cy) * 1.5) * 0.35
                # Broad trefoil clusters fill sprays; diamond leaves shape the
                # rim. Small dots belong to opening buds, not mature foliage.
                patch = random.Random(
                    f"{seed}:leaf-patch:{index}:{x // 3}:{y // 2}"
                ).random()
                weights = (8, 2, 0) if distance < 0.65 and patch < 0.65 else (5, 4, 0)
                if distance > 0.85:
                    weights = (2, 7, 0)
                glyph = texture.choices(("♣", "◆", "●"), weights)[0]
                # Light falls from the upper left, with a continuous dark underside.
                light = ny + nx * 0.22
                shade = 2 if light < -0.25 else 0 if light > 0.3 else 1
                if birth <= days + 1:
                    candidates[(x, y)] = (
                        x,
                        y,
                        birth,
                        glyph,
                        f"leaf{index % 3 * 3 + shade}",
                    )
        # A spray grows out from its actual supporting tip. Random texture
        # may create holes, but it must never create detached leaf islands.
        anchor = (round(cx), round(cy))
        if arrival + 0.5 <= days + 1:
            candidates[anchor] = (
                *anchor,
                arrival + 0.5,
                "♣",
                f"leaf{index % 3 * 3 + 1}",
            )
        pending = [anchor] if anchor in candidates else []
        reached = set(pending)
        while pending:
            x, y = pending.pop()
            cells.append(candidates[(x, y)])
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    neighbor = (x + dx, y + dy)
                    if neighbor in candidates and neighbor not in reached:
                        reached.add(neighbor)
                        pending.append(neighbor)
    # Fine dots soften only the outside of the combined foliage silhouette.
    # Test all sprays together so overlapping pads keep solid interiors.
    foliage = {(x, y) for x, y, birth, glyph, ink in cells if ink.startswith("leaf")}
    woody = set(wood) | {(x, y) for x, y, *_ in stem(days, seed)}
    result = []
    for x, y, birth, glyph, ink in cells:
        edge = any(
            (x + dx, y + dy) not in foliage
            for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1))
        )
        if ink.startswith("leaf") and edge and (x, y) not in woody:
            texture = random.Random(f"{seed}:leaf-edge:{x}:{y}")
            if texture.random() < 0.45:
                glyph = texture.choice(("•", "·"))
        result.append((x, y, birth, glyph, ink))
    return result


def specimen(seed, days=0, style="informal"):
    """Connected woody limbs supporting a broad, densely filled crown."""
    if style == "informal":
        return natural_specimen(seed, days)
    rng = random.Random(seed)
    centers = trunk_path(seed, style)
    crown_shift = (centers[-1] - 27) * 0.6
    cascade = cascade_path(seed) if style == "semi-cascade" else None
    wood = {}
    tips = []

    def shoot(x, y, tx, ty, born, twig=False, capacity=2.6):
        length = math.hypot(tx - x, ty - y)
        steps = max(1, math.ceil(length * 1.5))
        path = []
        for step in range(steps + 1):
            t = step / steps
            px = x + (tx - x) * t
            py = max(2, y + (ty - y) * t - math.sin(t * math.pi) * 0.5)
            birth = born + t * length * 0.55
            path.append((px, py, birth))
            if birth > days + 1:
                continue
            # Fill one continuous silhouette, rather than duplicating strokes.
            maturity = min(1, max(0, (days - birth - 5) / 25))
            radius = (0.75 if twig else 1.15) * maturity * (1 - t) ** 0.7
            vertical_scale = 1
            if style == "informal":
                # Annual girth develops after the shoot extends. Older lower
                # limbs have larger collars; tips and secondary twigs stay fine.
                wood_age = max(0, days - birth - 3)
                starter_radius = 0.35 if twig else 1.25
                radius = (
                    min(
                        0.9 if twig else capacity,
                        max(starter_radius, 0.65 * math.sqrt(wood_age)),
                    )
                    * (1 - t) ** 0.55
                )
                # Give main limbs a visible bark-filled body across several
                # terminal rows; only the fine twigs retain compressed girth.
                vertical_scale = 1.8 if twig else 1.15
            for cy in range(
                math.floor(py - radius / vertical_scale),
                math.ceil(py + radius / vertical_scale) + 1,
            ):
                for cx in range(math.floor(px - radius), math.ceil(px + radius) + 1):
                    if (cx - px) ** 2 + ((cy - py) * vertical_scale) ** 2 <= radius**2:
                        wood[(cx, cy)] = min(birth, wood.get((cx, cy), birth))
            # A rasterized centerline keeps fine new tips fully connected.
            key = (round(px), round(py))
            wood[key] = min(birth, wood.get(key, birth))
        return path

    # Upward-reaching limbs tuck beneath overlapping crown pads.
    tiers = (
        (5, 14, 8, 12),
        (8, 41, 7, 15),
        (10, 18, 4, 18),
        (12, 36, 3, 21),
        (14, 26, 2, 24),
    )
    if style == "informal":
        # Establish the two crown-bearing shoots as the leader reaches them.
        tiers = branch_layout(seed)
    if cascade:
        tiers = (
            (5, 27, 8, 12),
            (8, 38, 8, 15),
            (10, 44, 10, 18),
            (12, 49, 13, 21),
            (14, 50, 16, 24),
        )
    for depth, tx, ty, born in tiers:
        tx += (0 if cascade else crown_shift) + rng.uniform(-0.6, 0.6)
        ty += rng.uniform(-0.3, 0.3)
        origin_x, origin_y = cascade[depth] if cascade else (centers[depth], 18 - depth)
        capacity = max(1.2, 4 * (1 - depth / 20))
        path = shoot(origin_x, origin_y, tx, ty, born, capacity=capacity)
        tips.append(path[-1])
        for fraction in (0.6, 0.85):
            fx, fy, birth = path[round((len(path) - 1) * fraction)]
            side = -1 if tx < origin_x else 1
            fork = shoot(fx, fy, fx + side * 2, fy - 1.5, birth + 1, twig=True)
            tips.append(fork[-1])

    cells = []
    for (x, y), birth in sorted(wood.items()):
        above, below = (x, y - 1) in wood, (x, y + 1) in wood
        left, right = (x - 1, y) in wood, (x + 1, y) in wood
        if above and below:
            glyph, ink = ("╵" if (x * 3 + y) % 11 == 0 else " "), "bark"
            if style == "informal":
                glyph = "▒" if (x * 3 + y) % 5 else "╎"
        elif left and right:
            glyph, ink = "─", "woodlight" if not above else "wood"
        else:
            rising_right = (x + 1, y - 1) in wood or (x - 1, y + 1) in wood
            rising_left = (x - 1, y - 1) in wood or (x + 1, y + 1) in wood
            glyph = (
                "╱"
                if rising_right
                else "╲"
                if rising_left
                else "─"
                if left or right
                else "│"
            )
            ink = "wood"
        cells.append((x, y, birth, glyph, ink))

    # Unequal, overlapping pads keep a full crown while suggesting the rounded
    # tops and flatter undersides of a trained juniper bonsai.
    lobes = (
        (18, 7, 8, 2.6),
        (24, 3.7, 7, 3.2),
        (31, 4.2, 8, 3.5),
        (37, 6, 8, 2.8),
        (39, 8.2, 6, 2),
        (24, 8.8, 9, 2.4),
    )
    if style == "informal":
        lobes = (
            (14, 11, 7, 2.5),
            (18, 7, 8, 2.6),
            (24, 3.5, 6.5, 2.5),
            (32, 3.8, 6.5, 2.8),
            (37, 6, 7, 2.8),
            (43, 8.5, 6, 2.2),
        )
    if cascade:
        lobes = (
            (27, 7.5, 6, 2.6),
            (36, 7, 6, 2.6),
            (43, 9, 6, 2.4),
            (47, 12, 5, 2.3),
            (50, 15.5, 4, 2.4),
        )
    if style == "informal":
        layout = branch_layout(seed)
        lobes = list(lobes)
        for pad, limb in ((0, 0), (1, 2), (5, 1)):
            _, lx, ly, _ = layout[limb]
            _, _, rx, ry = lobes[pad]
            lobes[pad] = (lx, max(4.5, ly - 0.5), rx, ry)
        foliage_rng = random.Random(f"{seed}:foliage-shape")
        varied = []
        for index, (cx, cy, rx, ry) in enumerate(lobes):
            upper = index in (2, 3)
            varied.append(
                (
                    cx
                    + foliage_rng.uniform(
                        -0.6 if upper else -1.5, 0.6 if upper else 1.5
                    ),
                    cy if upper else cy + foliage_rng.uniform(-0.5, 0.5),
                    rx
                    * foliage_rng.uniform(1 if upper else 0.85, 1.1 if upper else 1.18),
                    ry if upper else ry * foliage_rng.uniform(0.85, 1.15),
                )
            )
        lobes = varied
    lobes = [
        (cx + (0 if cascade else crown_shift) + rng.uniform(-0.6, 0.6), cy, rx, ry)
        for cx, cy, rx, ry in lobes
    ]
    for y in range(1, 19 if cascade else 14 if style == "informal" else 12):
        for x in range(8, 56 if cascade else 49):
            pad_distances = [
                ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2
                if y <= cy + ry * 0.6
                else math.inf
                for cx, cy, rx, ry in lobes
            ]
            pad = min(range(len(lobes)), key=pad_distances.__getitem__)
            distance = pad_distances[pad]
            cx, cy, rx, ry = lobes[pad]
            # The two upper pads are the focal point: coherent, full sprays
            # with a rounded outline, rather than tiny scattered dots.
            top_pad = style == "informal" and pad in (2, 3)
            leafrng = random.Random(f"{seed}:crown:{x}:{y}")
            if distance > 1 or leafrng.random() < (0.035 if distance < 0.7 else 0.16):
                continue
            if (
                style == "informal"
                and not top_pad
                and leafrng.random() < (0.12 if y < 8 else 0.23)
            ):
                continue
            # Small seams below overlapping pads reveal their layered shape.
            separation = sorted(pad_distances)[1] - distance
            seam = y > cy + 0.5 and separation < 0.10
            if seam and not top_pad and leafrng.random() < 0.5:
                continue
            # Leaves spread from the nearest connected shoot into the crown.
            nearest = min(
                tips, key=lambda tip: math.hypot(x - tip[0], (y - tip[1]) * 1.5)
            )
            travel = math.hypot(x - nearest[0], (y - nearest[1]) * 1.5)
            birth = (
                nearest[2]
                + (2 if top_pad else 3)
                + travel * (0.45 if top_pad else 0.8)
                + leafrng.uniform(0, 2)
            )
            tone = pad % 3
            shade = 2 if y < cy - 0.5 else 0 if y > cy + 0.5 else 1
            # Real bonsai read as foliage sprays grouped into pads. Coherent
            # patches give a stronger size contrast than independent dots.
            patch = random.Random(f"{seed}:spray:{pad}:{x // 3}:{y // 2}").random()
            sizes = random.Random(f"{seed}:leaf-size:{x}:{y}")
            if distance > 0.8:
                weights = (0, 1, 4, 7)
            elif patch < 0.35:
                weights = (0, 1, 4, 6)
            elif patch < 0.7:
                weights = (2, 6, 3, 0)
            else:
                weights = (9, 2, 1, 0)
            glyph = sizes.choices(("♣", "●", "•", "·"), weights)[0]
            if style == "informal":
                glyph = sizes.choices(
                    ("◆", "●", "•", "·"),
                    (3, 4, 2, 1) if distance < 0.75 else (1, 2, 4, 3),
                )[0]
            if top_pad:
                glyph = sizes.choices(
                    ("◆", "●", "•", "·"),
                    (3, 6, 1, 0) if distance < 0.75 else (1, 3, 4, 1),
                )[0]
            cells.append((x, y, birth, glyph, f"leaf{tone * 3 + shade}"))
    return cells


def cover_crown_wood(canvas):
    """Keep a rooted silhouette, following connections through wood and foliage."""
    wood = {
        (x, y)
        for y, row in enumerate(canvas)
        for x, (glyph, ink) in enumerate(row)
        if glyph.strip()
        and (ink in ("wood", "woodlight", "bark") or ink.startswith("shoot"))
    }
    if not wood:
        return
    connected_art = wood | {
        (x, y)
        for y, row in enumerate(canvas)
        for x, (glyph, ink) in enumerate(row)
        if glyph.strip() and ink.startswith("leaf")
    }
    root_y = max(y for x, y in wood)
    reached = {(x, y) for x, y in wood if y == root_y}
    pending = list(reached)
    while pending:
        x, y = pending.pop()
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                point = (x + dx, y + dy)
                if point in connected_art and point not in reached:
                    reached.add(point)
                    pending.append(point)
    for x, y in connected_art - reached:
        canvas[y][x] = (" ", "")


# Ceramic inlay designs retained from the original framed greeting.
POT_MOTIFS = (
    ("╱─╲", "╲─╱"),
    ("╭───╮", "╰╮ ╭╯"),
    ("╲ ╱", " ╳ "),
    ("╱◇╲", "╲─╱"),
    ("╭◇╮", "╰─╯"),
    ("╭┬╮", "╰┴╯"),
    ("┌┬┐", "└┴┘"),
    ("╱│╲", "╲│╱"),
    ("╭─┬─╮", "╰─┴─╯"),
    ("╱╲ ╱╲", "╲╱ ╲╱"),
    ("╭╮ ╭╮", "╰╯ ╰╯"),
    ("╱─┬─╲", "╲─┴─╱"),
    ("┌─◇─┐", "└───┘"),
    ("╲│╱", "╱│╲"),
    ("╭◆╮", "╰─╯"),
    ("┌◇┐", "└─┘"),
)


def pot_rows(seed):
    """Keep the selected glaze pattern stable throughout a growth sequence."""
    rng = random.Random(f"{seed}:pot")
    upper, lower = rng.choice(POT_MOTIFS)
    gap = 1 if len(upper) == 5 else rng.choice((1, 2))
    bands = []
    for motif, half_width in ((upper, 10), (lower, 9)):
        repeat = motif + "─" * gap
        band = "".join(
            repeat[(x + len(motif) // 2) % len(repeat)]
            for x in range(-half_width, half_width + 1)
        )
        band = (
            "─" * (len(band) - len(band.lstrip()))
            + band.strip()
            + "─" * (len(band) - len(band.rstrip()))
        )
        bands.append(band)
    return (
        "╭─────────────────────╮",
        "╲" + bands[0] + "╱",
        " ╲" + bands[1] + "╱ ",
        "  ╰─────────────────╯  ",
    )


def frame_rows(rows, columns, accents, color):
    """Center the tree in terminal whitespace, retaining animation row count."""
    width = 57
    margin = " " * max(0, (columns - width - 2) // 2)
    # Keep the two reserved rows and side columns so cursor movement stays stable.
    blank = margin + " " * (width + 2)
    reset = "\033[0m" if color else ""
    return [blank] + [margin + " " + row + reset + " " for row in rows] + [blank]


def space_bark_shading(canvas, seed):
    """Use isolated shaded accents; fine grain keeps the limb body intact."""
    phase = random.Random(f"{seed}:shade-spacing").randrange(4)
    for y, row in enumerate(canvas):
        for x, (glyph, ink) in enumerate(row):
            if ink == "bark" and glyph in "░▒▓" and (x + 2 * y + phase) % 4:
                row[x] = ("·", ink)


@functools.lru_cache(maxsize=64)
def blossom_sites(seed):
    """Only some specimens bloom; sites remain fixed throughout growth."""
    rng = random.Random(f"{seed}:blossoms")
    if rng.random() >= 0.4:
        return ()
    candidates = sorted(
        {
            (x, y)
            for x, y, born, glyph, ink in natural_specimen(seed, 30)
            if ink.startswith("leaf")
            and glyph in "●◆"
            and born <= 31
            and 0 <= x < 57
            and 0 <= y < 19
        }
    )
    rng.shuffle(candidates)
    count = rng.randint(2, 4)
    chosen = []
    for x, y in candidates:
        if all(max(abs(x - px), abs(y - py)) >= 3 for px, py, born in chosen):
            chosen.append((x, y, rng.uniform(21, 26)))
        if len(chosen) == count:
            break
    return tuple(chosen)


def add_blossoms(canvas, seed, days):
    for x, y, born in blossom_sites(seed):
        if days >= born and canvas[y][x][1].startswith("leaf"):
            canvas[y][x] = ("✧" if days < born + 1 else "✿", "blossom")


@functools.lru_cache(maxsize=64)
def knurl_sites(seed):
    """Sparse, stable knots in substantial wood, away from fine tips."""
    rng = random.Random(f"{seed}:knurling")
    if rng.random() >= 0.45:
        return ()
    bark = {
        (x, y)
        for x, y, born, glyph, ink in stem(30, seed)
        if ink == "bark" and 7 <= y <= 17
    }
    bark.update(
        (x, y)
        for x, y, born, glyph, ink in natural_specimen(seed, 30)
        if ink == "bark" and 7 <= y <= 17
    )
    candidates = sorted((x, y) for x, y in bark if (x, y + 1) in bark)
    rng.shuffle(candidates)
    chosen = []
    count = rng.randint(1, 2)
    for x, y in candidates:
        if all(abs(y - py) >= 4 for px, py, born in chosen):
            chosen.append((x, y, rng.uniform(15, 23)))
        if len(chosen) == count:
            break
    return tuple(chosen)


def add_knurling(canvas, seed, days):
    for x, y, born in knurl_sites(seed):
        if days < born or canvas[y][x][1] != "bark" or canvas[y + 1][x][1] != "bark":
            continue
        # A small knot and raised grain accent, using the existing wood colors.
        canvas[y][x] = ("◦", "woodlight")
        canvas[y + 1][x] = ("╎", "bark")


@functools.lru_cache(maxsize=64)
def trunk_scar(seed):
    """One narrow scar following the existing middle-trunk interior."""
    rng = random.Random(f"{seed}:trunk-scar")
    if rng.random() >= 0.4:
        return ()
    bark = {(x, y) for x, y, born, glyph, ink in stem(30, seed) if ink == "bark"}
    centers = trunk_path(seed)
    bottom = rng.choice((14, 15, 16))
    length = rng.randint(4, 6)
    phase = rng.uniform(0, math.pi)
    began = rng.uniform(17, 20)
    path = []
    previous = None
    for index, y in enumerate(range(bottom, bottom - length, -1)):
        candidates = [
            x
            for x, py in bark
            if py == y and (previous is None or abs(x - previous) <= 1)
        ]
        if not candidates:
            break
        target = centers[18 - y] + math.sin(phase + index * 0.65) * 0.65
        x = min(candidates, key=lambda px: (abs(px - target), px))
        glyph = (
            "│" if previous is None or x == previous else "╱" if x > previous else "╲"
        )
        path.append((x, y, glyph, began + index * 0.8))
        previous = x
    return tuple(path) if len(path) >= 3 else ()


def add_trunk_scar(canvas, seed, days):
    path = trunk_scar(seed)
    occupied = {(x, y) for x, y, glyph, born in path}
    for x, y, glyph, born in path:
        if days < born or canvas[y][x][1] != "bark":
            continue
        canvas[y][x] = (glyph, "scar")
        # A restrained light edge stays inside existing bark, never the outline.
        for nx in (x + 1, x - 1):
            if (nx, y) not in occupied and canvas[y][nx][1] == "bark":
                canvas[y][nx] = ("·", "wood")
                break


def seat_tree_in_pot(canvas, days):
    """Join the root flare to the front rim without a dotted ground texture."""
    base = [
        x
        for x, (glyph, ink) in enumerate(canvas[18])
        if glyph.strip() and ink in ("wood", "woodlight", "bark", "scar")
    ]
    if base and days >= 10:
        for x, glyph in ((min(base) - 1, "╱"), (max(base) + 1, "╲")):
            if 17 < x < 37 and canvas[18][x][0] == " ":
                canvas[18][x] = (glyph, "wood")
    # The upward stroke joins the root base to the pot lip without a gap.
    canvas[18][27] = ("│", "wood")
    canvas[19][27] = ("┴", "pot")


def outline_exposed_wood(canvas):
    """Keep texture inside the wood and solid strokes on its exposed contour."""
    inks = {"wood", "woodlight", "bark", "scar"}
    wood = {
        (x, y)
        for y, row in enumerate(canvas[:19])
        for x, (glyph, ink) in enumerate(row)
        if ink in inks and glyph.strip()
    }
    occupied = {
        (x, y)
        for y, row in enumerate(canvas)
        for x, (glyph, ink) in enumerate(row)
        if glyph.strip()
    }
    for x, y in wood:
        neighbors = ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1))
        if all(point in occupied for point in neighbors):
            continue
        if canvas[y][x][0] in "│─╱╲╭╮":
            continue
        left_open, right_open = (x - 1, y) not in occupied, (x + 1, y) not in occupied
        if left_open or right_open:
            # Follow the same side of neighboring rows around each bend.
            side = min if left_open else max
            above = [px for px in (x - 1, x, x + 1) if (px, y - 1) in wood]
            below = [px for px in (x - 1, x, x + 1) if (px, y + 1) in wood]
            turn = (side(above) if above else x) - (side(below) if below else x)
            glyph = "╱" if turn > 0 else "╲" if turn < 0 else "│"
        else:
            glyph = "─"
        canvas[y][x] = (glyph, "wood")


def render(
    days,
    seed,
    color=True,
    columns=80,
    accents=None,
    style="informal",
    fixed_height=False,
    pot_seed=None,
):
    width, height = 57, 24
    canvas = [[(" ", "") for _ in range(width)] for _ in range(height)]
    # Growth starts with a rooted sapling; cells remain as new growth arrives.
    plan = specimen(seed, days, style)
    if style == "informal":
        plan += juvenile_foliage(days, seed)
    # Leaves cover the upper wood while the exposed lower stem keeps its contour.
    wood = [cell for cell in plan if not cell[4].startswith("leaf")]
    leaves = [cell for cell in plan if cell[4].startswith("leaf")]
    for x, y, born, glyph, ink in wood + stem(days, seed, style) + leaves:
        if born <= days + 1 and 0 <= x < width and 0 <= y < 19:
            canvas[y][x] = (glyph, ink)
    if style == "informal":
        cover_crown_wood(canvas)
        space_bark_shading(canvas, seed)
        add_trunk_scar(canvas, seed, days)
        add_knurling(canvas, seed, days)
        add_blossoms(canvas, seed, days)
    for y, row in enumerate(pot_rows(seed if pot_seed is None else pot_seed), 19):
        for x, char in enumerate(row, 16):
            ink = "pot"
            if y in (20, 21) and char not in " ╲╱":
                ink = "pot_inlay" if y == 20 or abs(x - 27) <= 2 else "pot_shadow"
            canvas[y][x] = (char, ink)
    seat_tree_in_pot(canvas, days)
    if style == "informal":
        outline_exposed_wood(canvas)
    occupied = [y for y, row in enumerate(canvas) if any(c != " " for c, _ in row)]
    # Foliage inherits the terminal theme; wood and ceramics keep their original colors.
    # No background color: the tree sits directly on the terminal surface.
    palette = {
        "wood": "\033[38;2;174;132;91m",
        "bark": "\033[38;2;126;91;62m",
        "woodlight": "\033[38;2;198;156;106m",
        "leaf": "\033[0;32m",
        "pot": "\033[0;90m",
        "pot_inlay": "\033[0;36m",
        "pot_shadow": "\033[0;2;37m",
        "shoot": "\033[0;37m",
        "scar": "\033[0;90m",
        "blossom": "\033[0;35m",
        "": "\033[0m",
    }
    if style == "informal":
        palette.update(
            wood="\033[38;2;185;158;119m",
            bark="\033[38;2;151;135;112m",
            woodlight="\033[38;2;214;195;155m",
        )
    palette["shoot"] = palette["wood"]
    palette["scar"] = "\033[38;2;98;88;73m"
    accents = accents if valid_palette(accents) else wallpaper_palette()
    for name, accent, brightness in (
        ("pot", accents[1], 0.85),
        ("pot_inlay", accents[0], 0.88),
        ("pot_shadow", accents[1], 0.55),
    ):
        rgb = [round(int(accent[k : k + 2], 16) * brightness) for k in (1, 3, 5)]
        palette[name] = "\033[38;2;{};{};{}m".format(*rgb)
    for i, slot in enumerate((32, 36, 34)):
        for name in ("mid", "tip"):
            palette[f"shoot_{name}{i}"] = f"\033[0;2;{slot}m"
        for j, intensity in enumerate(("2;", "", "")):
            key = f"leaf{i * 3 + j}"
            palette[key] = f"\033[0;{intensity}{slot}m"
    accents = accents if valid_palette(accents) else wallpaper_palette()
    output = []
    visible = canvas if fixed_height else canvas[min(occupied) : max(occupied) + 1]
    first_row = 0 if fixed_height else min(occupied)
    for y, row in enumerate(visible, first_row):
        parts, previous = [], None
        for x, (glyph, ink) in enumerate(row):
            if color and ink != previous:
                parts.append(palette[ink])
            parts.append(glyph)
            previous = ink
        output.append("".join(parts) + ("\033[0m" if color else ""))
    return "\n".join(frame_rows(output, columns, accents, color)) + "\n"


def animate_growth(seed, accents, duration=2.0, style="informal"):
    """Play a bounded, skippable greeting and leave its final tree in scrollback."""
    import select
    import signal
    import termios
    import tty

    columns, rows = shutil.get_terminal_size()
    pot_seed = random.SystemRandom().randrange(2**63)

    def picture(day, fixed=False):
        return render(
            day,
            seed,
            True,
            shutil.get_terminal_size().columns,
            accents,
            style,
            fixed_height=fixed,
            pot_seed=pot_seed,
        )

    if rows < 28 or os.environ.get("REDUCE_MOTION") == "1":
        print(picture(30), end="")
        return
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)

    def stop(signum, frame):
        raise KeyboardInterrupt

    old_term = signal.signal(signal.SIGTERM, stop)
    reserved = False
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\n" * 26 + "\033[?25l")
        reserved = True
        began = time.monotonic()
        while True:
            current_columns, current_rows = shutil.get_terminal_size()
            if current_columns < 59 or current_rows < 28:
                break
            elapsed = time.monotonic() - began
            day = min(30, elapsed / duration * 30)
            sys.stdout.write(
                "\033[?2026h\033[26A\r" + picture(day, True) + "\033[?2026l"
            )
            sys.stdout.flush()
            if day >= 30:
                break
            if select.select([fd], [], [], max(0, min(1 / 30, duration - elapsed)))[0]:
                os.read(fd, 1)
                break
    except KeyboardInterrupt:
        pass
    finally:
        try:
            current_columns, current_rows = shutil.get_terminal_size()
            if reserved and current_columns >= 59:
                if current_rows >= 28:
                    sys.stdout.write(
                        "\033[?2026h\033[26A\r" + picture(30, True) + "\033[?2026l"
                    )
                else:
                    sys.stdout.write("\n" + picture(30))
            sys.stdout.write("\033[0m\033[?25h\033[?2026l")
            sys.stdout.flush()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, previous)
            signal.signal(signal.SIGTERM, old_term)


def animate_background(seed, accents, duration, style):
    """Paint only the reserved greeting rows, without touching terminal input."""
    import signal

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    size = shutil.get_terminal_size()
    pot_seed = random.SystemRandom().randrange(2**63)
    began = time.monotonic()
    while shutil.get_terminal_size() == size:
        day = min(30, (time.monotonic() - began) / duration * 30)
        picture = render(
            day,
            seed,
            True,
            size.columns,
            accents,
            style,
            fixed_height=True,
            pot_seed=pot_seed,
        )
        # One synchronized write saves and restores Fish's editing cursor.
        frame = "\033[?2026h\0337\033[H" + picture + "\0338\033[?2026l"
        os.write(sys.stdout.fileno(), frame.encode())
        if day >= 30:
            break
        time.sleep(1 / 30)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--preview",
        type=float,
        metavar="DAYS",
        help="preview an age without changing saved growth",
    )
    parser.add_argument(
        "--seed", type=int, help="specimen for previews (default: saved tree, or 42)"
    )
    parser.add_argument(
        "--style",
        choices=("informal", "natural", "slant", "semi-cascade"),
        default="informal",
        help="trunk style; informal matches the tapered S-shaped reference",
    )
    parser.add_argument("--plain", action="store_true", help="disable colors")
    parser.add_argument(
        "--animate",
        action="store_true",
        help="Play full growth without changing saved age; any key skips",
    )
    parser.add_argument(
        "--duration",
        type=float,
        default=2.0,
        help="Time-lapse duration in seconds (default: 2)",
    )
    parser.add_argument(
        "--reserve-animation",
        action="store_true",
        help="Reserve greeting rows before Fish starts its prompt",
    )
    parser.add_argument(
        "--background",
        action="store_true",
        help="Animate reserved greeting rows without reading input",
    )
    args = parser.parse_args()
    if not math.isfinite(args.duration) or args.duration <= 0:
        parser.error("--duration must be a positive finite number")
    columns = shutil.get_terminal_size().columns
    if args.preview is None and (
        not sys.stdout.isatty() or columns < 59 or os.environ.get("TERM") == "dumb"
    ):
        return
    if args.reserve_animation:
        size = shutil.get_terminal_size()
        if size.lines < 30 or os.environ.get("REDUCE_MOTION") == "1":
            print(
                render(30, 42, True, columns, wallpaper_palette(), args.style), end=""
            )
            return 1
        # Scroll existing content into scrollback and leave two prompt rows.
        sys.stdout.write("\n" * size.lines + "\033[H\033[26B")
        sys.stdout.flush()
        return
    if args.background:
        animate_background(
            args.seed
            if args.seed is not None
            else random.SystemRandom().randrange(2**63),
            wallpaper_palette(),
            args.duration,
            args.style,
        )
        return
    if args.animate:
        if not sys.stdout.isatty() or not sys.stdin.isatty():
            return
        # New terminals get a fresh specimen; --seed keeps previews repeatable.
        seed = (
            args.seed
            if args.seed is not None
            else random.SystemRandom().randrange(2**63)
        )
        accents = wallpaper_palette()
        if args.plain:
            print(render(30, seed, False, columns, accents, args.style), end="")
        else:
            animate_growth(seed, accents, args.duration, args.style)
        return
    try:
        days, seed, accents = (
            age()
            if args.preview is None
            else (max(0, args.preview), *preview_identity(args.seed))
        )
        print(
            render(
                days,
                seed,
                not args.plain and sys.stdout.isatty(),
                columns,
                wallpaper_palette(),
                args.style,
            ),
            end="",
        )
    except OSError, ValueError, TypeError, AttributeError:
        return


if __name__ == "__main__":
    sys.exit(main())
