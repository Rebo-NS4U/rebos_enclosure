#!/usr/bin/env python3
"""A persistent, additive terminal bonsai. No ncurses or background process."""
import argparse
import fcntl
import functools
import json
import math
import os
from pathlib import Path
import random
import re
import shutil
import sys
import time


def valid_palette(value):
    return (isinstance(value, list) and len(value) == 3 and
            all(isinstance(c, str) and re.fullmatch(r'#[0-9a-fA-F]{6}', c) for c in value))


def wallpaper_palette():
    """Read the current desktop theme for foliage, ceramics and framing."""
    fallback = ['#85b470', '#b8ce93', '#67bca3']
    cache = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache'))
    try:
        data = json.loads((cache / 'rebos_shell/effective-palette.json').read_text())
        accents = [data.get(key) for key in ('primary', 'secondary', 'tertiary')]
        return accents if valid_palette(accents) else fallback
    except (OSError, ValueError, AttributeError):
        return fallback


def preview_identity(seed):
    directory = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'bonsai-grow'
    try:
        state = json.loads((directory / 'tree.json').read_text())
        saved_seed = state.get('seed')
        if type(saved_seed) is int:
            return saved_seed if seed is None else seed, wallpaper_palette()
    except (OSError, ValueError, AttributeError):
        pass
    return 42 if seed is None else seed, wallpaper_palette()


def age():
    directory = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'bonsai-grow'
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = directory / 'tree.json'
        if path.exists():
            state = json.loads(path.read_text())
        else:
            state = {'born': time.time(), 'opens': 0, 'seed': random.SystemRandom().randrange(2**31)}
        if (type(state.get('born')) not in (float, int) or
                type(state.get('opens')) is not int or state['opens'] < 0 or
                type(state.get('seed')) is not int):
            raise ValueError('Invalid bonsai state')
        # Older trees have no color snapshot; adopt the current wallpaper once.
        if 'palette' not in state:
            state['palette'] = wallpaper_palette()
        if not valid_palette(state['palette']):
            raise ValueError('Invalid saved palette')
        state['opens'] += 1
        temporary = directory / 'tree.json.tmp'
        temporary.write_text(json.dumps(state) + '\n')
        temporary.replace(path)
    return (max(0, time.time() - state['born']) / 86400 + (state['opens'] - 1) / 12,
            state['seed'], state['palette'])


def trunk_path(seed, style='informal'):
    """Seeded, smoothly joined bends; age never changes established wood."""
    rng = random.Random(f'{seed}:trunk')
    if style == 'informal':
        pattern, side = growth_pattern(seed)
        amplitude = rng.uniform(2, 3.5) if pattern == 'forked' else rng.uniform(4.5, 8)
        phase = rng.uniform(.8, 1.15)
        path = []
        for depth in range(15):
            t = depth / 14
            if pattern == 'upright':
                bend = .24 * math.sin(t * math.pi * phase)
            elif pattern == 'slant':
                bend = t ** .85
            elif pattern == 'bowed':
                bend = math.sin(t * math.pi * .8)
            elif pattern == 'forked':
                bend = .35 * math.sin(t*math.pi*.85)
            else:
                bend = math.sin(t * math.pi * 1.35) * .7 + .15*t
            x = 27 + side * amplitude * bend
            path.append(x if not path else max(path[-1]-.95, min(path[-1]+.95, x)))
        return path
    lean = rng.uniform(-5, 5)
    if style == 'slant':
        lean = (-1 if lean < 0 else 1) * rng.uniform(4, 6)
    depths = [0, *sorted(rng.sample(range(2, 13), rng.randint(2, 4))), 14]
    knots = [(0, 27)]
    for depth in depths[1:-1]:
        if style == 'slant':
            center = 27 + lean * (depth / 14)**.75 + rng.uniform(-.5, .5)
        else:
            center = 27 + lean * depth / 14 + rng.uniform(-3.5, 3.5)
        knots.append((depth, center))
    knots.append((14, 27 + lean))
    path = []
    segment = 0
    for depth in range(15):
        while depth > knots[segment + 1][0]:
            segment += 1
        d0, x0 = knots[segment]
        d1, x1 = knots[segment + 1]
        t = (depth - d0) / (d1 - d0)
        center = x0 + (x1 - x0) * t * t * (3 - 2 * t)
        if path:
            # Keep neighboring rows connected even on strongly curved trunks.
            center = max(path[-1] - .9, min(path[-1] + .9, center))
        path.append(center)
    return path


def cascade_path(seed):
    """Rise from the pot, curve outward, then descend beyond its rim."""
    rng = random.Random(f'{seed}:cascade')
    controls = ((27, 18), (27 + rng.uniform(-1, 1), 7 + rng.uniform(-1, 1)),
                (42 + rng.uniform(-1, 1), 7 + rng.uniform(-1, 1)), (47, 17))
    path = []
    for depth in range(15):
        t = depth / 14
        weights = ((1 - t)**3, 3 * (1 - t)**2 * t, 3 * (1 - t) * t*t, t**3)
        path.append(tuple(sum(p[axis] * w for p, w in zip(controls, weights)) for axis in (0, 1)))
    return path


def cascade_stem(days, seed):
    path = cascade_path(seed)
    height = min(len(path), 2 + int(days * .7))
    wood = set()
    for depth in range(height - 1):
        x0, y0 = path[depth]
        x1, y1 = path[depth + 1]
        steps = max(1, math.ceil(math.hypot(x1 - x0, y1 - y0) * 3))
        for step in range(steps + 1):
            t = step / steps
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            age = max(0, days - (depth + t) * .85)
            radius = min(1.8, age / 22, (height - 1 - depth - t) * .7)
            wood.add((round(x), round(y)))
            for cy in range(math.floor(y - radius), math.ceil(y + radius) + 1):
                for cx in range(math.floor(x - radius * 1.4), math.ceil(x + radius * 1.4) + 1):
                    if ((cx - x) / 1.4)**2 + (cy - y)**2 <= radius**2:
                        wood.add((cx, cy))
    cells = []
    for x, y in sorted(wood):
        interior = all(p in wood for p in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)))
        if interior:
            glyph, ink = ('╵' if (x * 3 + y) % 9 == 0 else ' '), 'bark'
        else:
            nearest = min(range(height), key=lambda d: (path[d][0]-x)**2 + (path[d][1]-y)**2)
            before, after = path[max(0, nearest-1)], path[min(height-1, nearest+1)]
            dx, dy = after[0]-before[0], after[1]-before[1]
            glyph = '│' if abs(dx) < abs(dy)*.6 else '─' if abs(dy) < abs(dx)*.35 else '╱' if dx*dy < 0 else '╲'
            ink = 'wood'
        cells.append((x, y, 0, glyph, ink))
    return cells


def stem(days, seed=42, style='informal'):
    """A tapered trunk: length, girth, roots and bark develop at different rates."""
    if style == 'semi-cascade':
        return cascade_stem(days, seed)
    centers = trunk_path(seed, style)
    height = min(len(centers), 2 + int(days * .7))
    contours = []
    for depth in range(height):
        # Older wood thickens first; the growing tip always stays narrow.
        girth = min(6, max(0, int((days - depth * .85) / 5)))
        if style == 'informal':
            # Give the young stem a visible body below its tapered tip.
            starter_girth = 2 if depth < height - 2 else 1 if depth < height - 1 else 0
            girth = max(girth, starter_girth)
            girth = min(girth, max(0, round(4 * (1 - depth / 15)**.9)))
        girth = min(girth, (height - depth - 1) * 2)
        if depth == 0 and days >= 14:
            girth += 2
        left = round(centers[depth] - girth / 2)
        contours.append((left, left + girth))
    cells = []
    for depth, (left, right) in enumerate(contours):
        upper = contours[min(depth + 1, height - 1)]
        y = 18 - depth
        if left == right:
            below = centers[max(0, depth - 1)]
            glyph = '╱' if centers[depth] > below + .3 else '╲' if centers[depth] < below - .3 else '│'
            cells.append((left, y, 0, glyph, 'wood'))
            continue
        for x in range(left, right + 1):
            if x == left:
                glyph = '╱' if upper[0] > left else '╲' if upper[0] < left else '│'
                ink = 'wood'
            elif x == right:
                glyph = '╲' if upper[1] < right else '╱' if upper[1] > right else '│'
                ink = 'wood'
            else:
                # Quiet vertical grain and a few scars emerge on older bark.
                glyph = '│' if (x + depth * 3) % 7 == 0 else '╵' if (x * 7 + depth) % 13 == 0 else ' '
                ink = 'bark'
                if style == 'informal':
                    grain = random.Random(f'{seed}:bark:{depth}:{x}')
                    # Grain follows the trunk tangent instead of random slashes.
                    turn = centers[min(depth + 1, height - 1)] - centers[depth]
                    grain_stroke = '╱' if turn > .2 else '╲' if turn < -.2 else '╎'
                    glyph = grain.choices(('░', '▒', grain_stroke), (3, 6, 1))[0]
            cells.append((x, y, 0, glyph, ink))
    # A small growing tip is visible even during the bare-stem phase.
    tip = '╮' if centers[height - 1] >= centers[max(0, height - 2)] else '╭'
    cells.append((round(centers[height - 1]), 18 - height, 0, tip, 'woodlight'))
    if style == 'informal' and days >= 18:
        # Surface roots spread over the soil and anchor the mature silhouette.
        spread = min(7, 4 + int((days - 18) / 8))
        for side in (-1, 1):
            for offset in range(3, spread + 1):
                glyph = ('╱' if side < 0 else '╲') if offset == spread else '─'
                cells.append((27 + side * offset, 18, 0, glyph, 'wood'))
    return cells


def growth_pattern(seed):
    """Choose a whole-tree habit, not just jitter around the same silhouette."""
    rng = random.Random(f'{seed}:habit')
    return rng.choice(('upright', 'slant', 'bowed', 'forked', 'recurved')), rng.choice((-1, 1))


def branch_layout(seed):
    """Share each specimen's varied limb plan with its starter leaves."""
    rng = random.Random(f'{seed}:limb-layout')
    pattern, side = growth_pattern(seed)
    centers = trunk_path(seed)
    if pattern == 'forked':
        # Two rising scaffold arms make an open Y-shaped crown above a stout base.
        shift = (centers[-1]-27)*.6
        result = []
        for index, direction in enumerate((side, -side)):
            depth = rng.choice((6,7,8))
            reach = rng.uniform(7.5,10.5)
            x = centers[depth] + direction*reach
            result.append((depth,x-shift,rng.uniform(3.8,5.3),
                           max((depth-1)/.7,11+index*.6)))
        depth = rng.choice((9,10))
        result.append((depth,centers[depth]-shift+side*rng.uniform(1.5,3),
                       2.8,max((depth-1)/.7,14)))
        return result
    attachments = sorted(rng.sample(range(4, 11), 3))
    if pattern == 'windswept':
        # Keep a visible low limb instead of bunching every pad at the apex.
        attachments = [rng.randint(4, 5), rng.randint(7, 8), rng.randint(10, 11)]
        sides = (side, side, side)
    elif pattern == 'bowed':
        sides = (-side, side, side)
    elif pattern == 'upright':
        sides = (side, -side, -side)
    else:
        sides = (side, side, -side) if rng.random() < .5 else (-side, side, -side)
    result = []
    for index, (depth, direction) in enumerate(zip(attachments, sides)):
        reach = rng.uniform(8, 14) if index < 2 else rng.uniform(6, 11)
        if pattern == 'windswept':
            reach = min(reach, 8.5 - depth * .35)
        x = max(11, min(44, centers[depth] + direction * reach))
        y = max(3.5, 18 - depth - max(2, abs(x-centers[depth])*.3) - rng.uniform(0, .6))
        born = max((depth-1)/.7, 11 + index*2 + rng.uniform(-1, 1))
        # The renderer applies the crown offset once to every limb.
        result.append((depth, x - (centers[-1]-27)*.6, y, born))
    for depth in sorted(rng.sample(range(11, 15), rng.randint(1, 3))):
        direction = side if pattern == 'windswept' else rng.choice((-1, 1))
        x = centers[depth] + direction * rng.uniform(2, 4 if pattern == 'windswept' else 7)
        result.append((depth, x - (centers[-1]-27)*.6,
                       rng.uniform(2, 3.5), max((depth-1)/.7, 17)))
    return result


def juvenile_foliage(days, seed):
    """Leafy node pairs unfold along the young leader, then yield to its crown."""
    centers = trunk_path(seed, 'informal')
    height = min(len(centers), 2 + int(days * .7))
    cells = []
    # The original pair follows the leader until the first limb attachments
    # establish, then travels outward on those limbs as their tips extend.
    primaries = [branch for branch in branch_graph(seed) if branch['parent'] is None]
    for cohort, branch in enumerate(primaries[:2]):
        attachment = round(18 - branch['start'][1])
        tx, ty = branch['end']
        branch_born = branch['born']
        depth = min(height - 1, attachment)
        born, age = 0, days
        x, y = round(centers[depth]), 18 - depth
        length = math.hypot(tx - x, ty - y)
        progress = min(1, max(2 / length, (days + 1 - branch_born) / (length * .55)))
        tip_x = round(x + (tx - x) * progress)
        tip_y = round(y + (ty - y) * progress - math.sin(progress * math.pi) * branch['curve'])
        side = 1 if tx >= x else -1
        tone = (cohort + (side > 0)) % 3
        leaves = []
        for index, (dx, dy, delay) in enumerate(((1, 0, 0), (0, -1, 2))):
            rng = random.Random(f'{seed}:juvenile:{cohort}:{side}:{index}')
            shed = min(29, 24 + cohort * 1.5 + rng.uniform(0, 2))
            if age < delay or days >= shed:
                continue
            unfold = age - delay
            glyph = '·' if unfold < .5 else '•' if unfold < 2.5 else '●'
            tone = (cohort + (side > 0)) % 3
            shade = 2 if dy < 0 else 1
            leaves.append((tip_x + side * dx, tip_y + dy, born + delay,
                           glyph, f'leaf{tone * 3 + shade}'))
        if not leaves:
            continue
        steps = max(abs(tip_x - x), abs(tip_y - y), 1)
        path = []
        for step in range(1, steps + 1):
            t = step / steps
            point = (round(x + (tip_x - x) * t), round(y + (tip_y - y) * t))
            if path and point == path[-1]:
                continue
            path.append(point)
        previous_y = y
        for index, (sx, sy) in enumerate(path):
            is_tip = index == len(path) - 1
            glyph = ('╱' if side > 0 else '╲') if sy < previous_y else '─'
            ink = f'shoot_tip{tone:d}' if is_tip else f'shoot_mid{tone:d}'
            cells.append((sx, sy, born, glyph, ink))
            previous_y = sy
        cells.extend(leaves)
    # No temporary woody spurs remain after the juvenile leaves retire.
    return cells if days < 29 else []


def branch_point(branch, t):
    x, y = branch['start']
    tx, ty = branch['end']
    return (x + (tx-x)*t, y + (ty-y)*t - math.sin(t*math.pi)*branch['curve'])


@functools.lru_cache(maxsize=64)
def branch_graph(seed):
    """A rooted hierarchy: uneven secondary forks inherit their parent's path."""
    rng = random.Random(f'{seed}:branch-graph')
    jitter = random.Random(seed)
    centers = trunk_path(seed)
    shift = (centers[-1]-27)*.6
    habit, wind = growth_pattern(seed)
    branches = []
    layout = branch_layout(seed)
    directions = {1 if x + shift >= centers[depth] else -1
                  for depth, x, y, born in layout[:3]}
    one_sided = len(directions) == 1
    def add(start, end, born, width, parent=None, attachment=0, level=0, leader=False, lower=False):
        # Stagger crown-tip heights instead of clipping every twig to one roof.
        ceiling = rng.uniform(2.7, 3.1) if leader else rng.uniform(3.2, 5.2)
        end = (max(9, min(47, end[0])), max(ceiling, min(15 if lower else 14, end[1])))
        if level == 0 and not leader and not lower:
            # A shallow upper limb must stay short; it cannot become a shelf.
            run_limit = 1.5 + 3*max(0, start[1]-end[1])
            end = (max(start[0]-run_limit, min(start[0]+run_limit, end[0])), end[1])
        if one_sided and not leader:
            # Taper the swept crown around the trunk instead of stacking
            # ever-longer horizontal forks against the outside edge.
            center = centers[min(14, max(0, round(18-end[1])))]
            reach_limit = 3.5 + max(0, end[1]-3)*.4
            end = (max(center-reach_limit, min(center+reach_limit, end[0])), end[1])
        length = math.hypot(end[0]-start[0], end[1]-start[1])
        branch = dict(start=start, end=end, born=born, width=width,
                      parent=parent, attachment=attachment, length=length,
                      curve=0 if lower else rng.uniform(.15, .7),
                      level=level, leader=leader, lower=lower)
        index = len(branches)
        branches.append(branch)
        if lower or level >= (1 if one_sided else 2) or length < 3:
            return
        # One stronger continuation and a shorter lateral fork, at unequal nodes.
        for child, fraction in enumerate((rng.uniform(.7, .95), rng.uniform(.4, .7))):
            origin = branch_point(branch, fraction)
            direction = 1 if end[0] >= start[0] else -1
            if child and habit != 'windswept' and rng.random() < .55:
                direction *= -1
            if habit == 'windswept':
                direction = wind
            reach = length * rng.uniform(.45, .65) * (1 if child == 0 else .6)
            if leader:
                # The apex keeps reaching upward instead of becoming another
                # long horizontal, wind-driven limb.
                direction = wind if child == 0 else -wind
                reach = rng.uniform(1.2, 2.8)
            target = (origin[0] + direction * reach,
                      origin[1] - rng.uniform(1.8 if leader else 1.3, 3) * (1 if child == 0 else .65))
            arrival = born + length * fraction * .55
            add(origin, target, arrival + rng.uniform(.3, .9),
                width * (.58 if child == 0 else .38), index, fraction, level+1, leader)
    for depth, tx, ty, born in layout:
        tx += shift + jitter.uniform(-.6, .6)
        ty += jitter.uniform(-.3, .3)
        if one_sided and depth >= 11:
            tx = centers[depth] + (tx-centers[depth]) * .55
        add((centers[depth], 18-depth), (tx, ty), born, max(.55, 1.45*(1-depth/24)))
    if one_sided:
        # Give the swept lower body a distinct vertical continuation and crown.
        add((centers[11], 7), (centers[-1] + wind*1.2, 2.7),
            17, .85, leader=True)
    return branches


def natural_specimen(seed, days):
    """Render connected tapered wood and leaf sprays at its own terminal tips."""
    graph = branch_graph(seed)
    wood = {}
    strokes = {}
    centerline = set()
    for branch in graph:
        steps = max(1, math.ceil(branch['length']*2))
        for step in range(steps+1):
            t = step/steps
            birth = branch['born'] + branch['length']*t*.55
            if birth > days+1:
                continue
            px, py = branch_point(branch, t)
            dx = branch['end'][0]-branch['start'][0]
            dy = branch['end'][1]-branch['start'][1] - math.pi*math.cos(t*math.pi)*branch['curve']
            stroke = '─' if abs(dy) < abs(dx)*.25 else '│' if abs(dx) < abs(dy)*.5 else '╱' if dx*dy < 0 else '╲'
            age = max(0, days-birth)
            radius = min(branch['width'], (1.4 if branch['level'] == 0 else .4)+math.sqrt(age)*.25)*(1-t)**.7
            if branch['level'] == 0:
                radius = min(1.35, radius*1.4)
            # Keep a rounded body through the limb, narrowing continuously
            # toward the twig rather than switching abruptly to a line.
            vertical_scale = 1.05 if branch['level'] == 0 else 1.6
            for y in range(math.floor(py-radius), math.ceil(py+radius)+1):
                for x in range(math.floor(px-radius), math.ceil(px+radius)+1):
                    if (x-px)**2 + ((y-py)*vertical_scale)**2 <= radius**2:
                        if birth <= wood.get((x,y), math.inf):
                            wood[(x,y)] = birth
                            strokes[(x,y)] = stroke
            key = (round(px), round(py))
            centerline.add(key)
            if birth <= wood.get(key, math.inf):
                wood[key] = birth
                strokes[key] = stroke
    cells = []
    for (x,y), birth in wood.items():
        interior = all(point in wood for point in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)))
        filled = (x,y) not in centerline or interior
        glyph = '░' if filled else strokes[(x,y)]
        cells.append((x,y,birth,glyph,'bark' if filled else 'wood'))
    parents = {branch['parent'] for branch in graph if branch['parent'] is not None}
    compact = any(branch['leader'] for branch in graph)
    for index, branch in enumerate(graph):
        if index in parents:
            continue
        cx, cy = branch['end']
        rng = random.Random(f'{seed}:terminal:{index}')
        rx, ry = (rng.uniform(2.6,3.8), rng.uniform(1.3,1.9)) if compact else (rng.uniform(3.2,5), rng.uniform(1.6,2.4))
        if branch.get('lower', False):
            rx, ry = rng.uniform(2.5,3.3), rng.uniform(1,1.35)
        arrival = branch['born'] + branch['length']*.55
        candidates = {}
        for y in range(max(1,math.floor(cy-ry)), min(18,math.ceil(cy+ry))+1):
            for x in range(max(2,math.floor(cx-rx)), min(54,math.ceil(cx+rx))+1):
                distance = ((x-cx)/rx)**2 + ((y-cy)/ry)**2
                if distance > 1 or rng.random() < (.05 if distance < .7 else .23):
                    continue
                birth = arrival + .5 + math.hypot(x-cx,(y-cy)*1.5)*.35
                glyph = rng.choices(('●','◆','•','·'), (5,2,2,1) if distance < .7 else (1,1,4,3))[0]
                shade = 2 if y < cy else 1 if y == round(cy) else 0
                if birth <= days+1:
                    candidates[(x,y)] = (x,y,birth,glyph,f'leaf{index%3*3+shade}')
        # A spray grows out from its actual supporting tip. Random texture
        # may create holes, but it must never create detached leaf islands.
        anchor = (round(cx), round(cy))
        if arrival + .5 <= days+1:
            candidates[anchor] = (*anchor, arrival+.5, '●', f'leaf{index%3*3+1}')
        pending = [anchor] if anchor in candidates else []
        reached = set(pending)
        while pending:
            x, y = pending.pop()
            cells.append(candidates[(x,y)])
            for dx in (-1,0,1):
                for dy in (-1,0,1):
                    neighbor = (x+dx,y+dy)
                    if neighbor in candidates and neighbor not in reached:
                        reached.add(neighbor)
                        pending.append(neighbor)
    return cells


def specimen(seed, days=0, style='informal'):
    """Connected woody limbs supporting a broad, densely filled crown."""
    if style == 'informal':
        return natural_specimen(seed, days)
    rng = random.Random(seed)
    centers = trunk_path(seed, style)
    crown_shift = (centers[-1] - 27) * .6
    cascade = cascade_path(seed) if style == 'semi-cascade' else None
    wood = {}
    tips = []

    def shoot(x, y, tx, ty, born, twig=False, capacity=2.6):
        length = math.hypot(tx - x, ty - y)
        steps = max(1, math.ceil(length * 1.5))
        path = []
        for step in range(steps + 1):
            t = step / steps
            px = x + (tx - x) * t
            py = max(2, y + (ty - y) * t - math.sin(t * math.pi) * .5)
            birth = born + t * length * .55
            path.append((px, py, birth))
            if birth > days + 1:
                continue
            # Fill one continuous silhouette, rather than duplicating strokes.
            maturity = min(1, max(0, (days - birth - 5) / 25))
            radius = (.75 if twig else 1.15) * maturity * (1 - t)**.7
            vertical_scale = 1
            if style == 'informal':
                # Annual girth develops after the shoot extends. Older lower
                # limbs have larger collars; tips and secondary twigs stay fine.
                wood_age = max(0, days - birth - 3)
                starter_radius = .35 if twig else 1.25
                radius = min(.9 if twig else capacity, max(starter_radius, .65 * math.sqrt(wood_age))) * (1-t)**.55
                # Give main limbs a visible bark-filled body across several
                # terminal rows; only the fine twigs retain compressed girth.
                vertical_scale = 1.8 if twig else 1.15
            for cy in range(math.floor(py - radius / vertical_scale), math.ceil(py + radius / vertical_scale) + 1):
                for cx in range(math.floor(px - radius), math.ceil(px + radius) + 1):
                    if (cx - px)**2 + ((cy - py) * vertical_scale)**2 <= radius**2:
                        wood[(cx, cy)] = min(birth, wood.get((cx, cy), birth))
            # A rasterized centerline keeps fine new tips fully connected.
            key = (round(px), round(py))
            wood[key] = min(birth, wood.get(key, birth))
        return path

    # Upward-reaching limbs tuck beneath overlapping crown pads.
    tiers = ((5, 14, 8, 12), (8, 41, 7, 15), (10, 18, 4, 18), (12, 36, 3, 21), (14, 26, 2, 24))
    if style == 'informal':
        # Establish the two crown-bearing shoots as the leader reaches them.
        tiers = branch_layout(seed)
    if cascade:
        tiers = ((5, 27, 8, 12), (8, 38, 8, 15), (10, 44, 10, 18), (12, 49, 13, 21), (14, 50, 16, 24))
    for depth, tx, ty, born in tiers:
        tx += (0 if cascade else crown_shift) + rng.uniform(-.6, .6)
        ty += rng.uniform(-.3, .3)
        origin_x, origin_y = cascade[depth] if cascade else (centers[depth], 18 - depth)
        capacity = max(1.2, 4 * (1 - depth / 20))
        path = shoot(origin_x, origin_y, tx, ty, born, capacity=capacity)
        tips.append(path[-1])
        for fraction in (.6, .85):
            fx, fy, birth = path[round((len(path) - 1) * fraction)]
            side = -1 if tx < origin_x else 1
            fork = shoot(fx, fy, fx + side * 2, fy - 1.5, birth + 1, twig=True)
            tips.append(fork[-1])

    cells = []
    for (x, y), birth in sorted(wood.items()):
        above, below = (x, y - 1) in wood, (x, y + 1) in wood
        left, right = (x - 1, y) in wood, (x + 1, y) in wood
        if above and below:
            glyph, ink = ('╵' if (x * 3 + y) % 11 == 0 else ' '), 'bark'
            if style == 'informal':
                glyph = '▒' if (x * 3 + y) % 5 else '╎'
        elif left and right:
            glyph, ink = '─', 'woodlight' if not above else 'wood'
        else:
            rising_right = (x + 1, y - 1) in wood or (x - 1, y + 1) in wood
            rising_left = (x - 1, y - 1) in wood or (x + 1, y + 1) in wood
            glyph = '╱' if rising_right else '╲' if rising_left else '─' if left or right else '│'
            ink = 'wood'
        cells.append((x, y, birth, glyph, ink))

    # Unequal, overlapping pads keep a full crown while suggesting the rounded
    # tops and flatter undersides of a trained juniper bonsai.
    lobes = ((18, 7, 8, 2.6), (24, 3.7, 7, 3.2), (31, 4.2, 8, 3.5),
             (37, 6, 8, 2.8), (39, 8.2, 6, 2), (24, 8.8, 9, 2.4))
    if style == 'informal':
        lobes = ((14, 11, 7, 2.5), (18, 7, 8, 2.6), (24, 3.5, 6.5, 2.5),
                 (32, 3.8, 6.5, 2.8), (37, 6, 7, 2.8), (43, 8.5, 6, 2.2))
    if cascade:
        lobes = ((27, 7.5, 6, 2.6), (36, 7, 6, 2.6), (43, 9, 6, 2.4),
                 (47, 12, 5, 2.3), (50, 15.5, 4, 2.4))
    if style == 'informal':
        layout = branch_layout(seed)
        lobes = list(lobes)
        for pad, limb in ((0, 0), (1, 2), (5, 1)):
            _, lx, ly, _ = layout[limb]
            _, _, rx, ry = lobes[pad]
            lobes[pad] = (lx, max(4.5, ly - .5), rx, ry)
        foliage_rng = random.Random(f'{seed}:foliage-shape')
        varied = []
        for index, (cx, cy, rx, ry) in enumerate(lobes):
            upper = index in (2, 3)
            varied.append((cx + foliage_rng.uniform(-.6 if upper else -1.5, .6 if upper else 1.5),
                cy if upper else cy + foliage_rng.uniform(-.5, .5),
                rx * foliage_rng.uniform(1 if upper else .85, 1.1 if upper else 1.18),
                ry if upper else ry * foliage_rng.uniform(.85, 1.15)))
        lobes = varied
    lobes = [(cx + (0 if cascade else crown_shift) + rng.uniform(-.6, .6), cy, rx, ry) for cx, cy, rx, ry in lobes]
    for y in range(1, 19 if cascade else 14 if style == 'informal' else 12):
        for x in range(8, 56 if cascade else 49):
            pad_distances = [((x - cx) / rx)**2 + ((y - cy) / ry)**2 if y <= cy + ry * .6 else math.inf
                             for cx, cy, rx, ry in lobes]
            pad = min(range(len(lobes)), key=pad_distances.__getitem__)
            distance = pad_distances[pad]
            cx, cy, rx, ry = lobes[pad]
            # The two upper pads are the focal point: coherent, full sprays
            # with a rounded outline, rather than tiny scattered dots.
            top_pad = style == 'informal' and pad in (2, 3)
            leafrng = random.Random(f'{seed}:crown:{x}:{y}')
            if distance > 1 or leafrng.random() < (.035 if distance < .7 else .16):
                continue
            if style == 'informal' and not top_pad and leafrng.random() < (.12 if y < 8 else .23):
                continue
            # Small seams below overlapping pads reveal their layered shape.
            separation = sorted(pad_distances)[1] - distance
            seam = y > cy + .5 and separation < .10
            if seam and not top_pad and leafrng.random() < .5:
                continue
            # Leaves spread from the nearest connected shoot into the crown.
            nearest = min(tips, key=lambda tip: math.hypot(x - tip[0], (y - tip[1]) * 1.5))
            travel = math.hypot(x - nearest[0], (y - nearest[1]) * 1.5)
            birth = nearest[2] + (2 if top_pad else 3) + travel * (.45 if top_pad else .8) + leafrng.uniform(0, 2)
            tone = pad % 3
            shade = 2 if y < cy - .5 else 0 if y > cy + .5 else 1
            # Real bonsai read as foliage sprays grouped into pads. Coherent
            # patches give a stronger size contrast than independent dots.
            patch = random.Random(f'{seed}:spray:{pad}:{x // 3}:{y // 2}').random()
            sizes = random.Random(f'{seed}:leaf-size:{x}:{y}')
            if distance > .8:
                weights = (0, 1, 4, 7)
            elif patch < .35:
                weights = (0, 1, 4, 6)
            elif patch < .7:
                weights = (2, 6, 3, 0)
            else:
                weights = (9, 2, 1, 0)
            glyph = sizes.choices(('♣', '●', '•', '·'), weights)[0]
            if style == 'informal':
                glyph = sizes.choices(('◆', '●', '•', '·'), (3, 4, 2, 1) if distance < .75 else (1, 2, 4, 3))[0]
            if top_pad:
                glyph = sizes.choices(('◆', '●', '•', '·'),
                    (3, 6, 1, 0) if distance < .75 else (1, 3, 4, 1))[0]
            cells.append((x, y, birth, glyph, f'leaf{tone * 3 + shade}'))
    return cells


def cover_crown_wood(canvas):
    """Keep a rooted silhouette, following connections through wood and foliage."""
    wood = {(x,y) for y,row in enumerate(canvas) for x,(glyph,ink) in enumerate(row)
            if glyph.strip() and (ink in ('wood','woodlight','bark') or ink.startswith('shoot'))}
    if not wood:
        return
    connected_art = wood | {(x,y) for y,row in enumerate(canvas)
                            for x,(glyph,ink) in enumerate(row)
                            if glyph.strip() and ink.startswith('leaf')}
    root_y = max(y for x,y in wood)
    reached = {(x,y) for x,y in wood if y == root_y}
    pending = list(reached)
    while pending:
        x,y = pending.pop()
        for dx in (-1,0,1):
            for dy in (-1,0,1):
                point = (x+dx,y+dy)
                if point in connected_art and point not in reached:
                    reached.add(point)
                    pending.append(point)
    for x,y in connected_art - reached:
        canvas[y][x] = (' ', '')


# Ceramic inlay designs from the pushed terminal-bonsai greeting.
POT_MOTIFS = (('╱─╲', '╲─╱'), ('╭───╮', '╰╮ ╭╯'), ('╲ ╱', ' ╳ '), ('╱◇╲', '╲─╱'), ('╭◇╮', '╰─╯'), ('╭┬╮', '╰┴╯'), ('┌┬┐', '└┴┘'), ('╱│╲', '╲│╱'), ('╭─┬─╮', '╰─┴─╯'), ('╱╲ ╱╲', '╲╱ ╲╱'), ('╭╮ ╭╮', '╰╯ ╰╯'), ('╱─┬─╲', '╲─┴─╱'), ('┌─◇─┐', '└───┘'), ('╲│╱', '╱│╲'), ('╭◆╮', '╰─╯'), ('┌◇┐', '└─┘'))


def pot_rows(seed):
    """Keep the selected glaze pattern stable throughout a growth sequence."""
    rng = random.Random(f'{seed}:pot')
    upper, lower = rng.choice(POT_MOTIFS)
    gap = 1 if len(upper) == 5 else rng.choice((1, 2))
    bands = []
    for motif, half_width in ((upper, 10), (lower, 9)):
        repeat = motif + '─' * gap
        band = ''.join(repeat[(x + len(motif) // 2) % len(repeat)]
                       for x in range(-half_width, half_width + 1))
        band = '─' * (len(band) - len(band.lstrip())) + band.strip() + '─' * (len(band) - len(band.rstrip()))
        bands.append(band)
    return ('╭─────────────────────╮', '╲' + bands[0] + '╱',
            ' ╲' + bands[1] + '╱ ', '  ╰─────────────────╯  ')


def frame_rows(rows, columns, accents, color):
    """The original double-line frame with themed gradient rails and quiet sides."""
    width = 57
    reset = '\033[0m' if color else ''
    margin = ' ' * max(0, (min(columns, 90) - width - 2) // 2)
    def blend(first, second, amount, brightness):
        if not color:
            return ''
        rgb = [round((int(first[k:k+2], 16) * (1-amount)
                      + int(second[k:k+2], 16) * amount) * brightness)
               for k in (1, 3, 5)]
        return '\033[38;2;{};{};{}m'.format(*rgb)
    def rail(left, right):
        return (margin + blend(accents[0], accents[0], 0, .9) + left
                + ''.join(blend(accents[0], accents[2], x/(width-1), .65) + '═'
                          for x in range(width))
                + blend(accents[2], accents[2], 0, .9) + right + reset)
    output = [rail('╔', '╗')]
    for index, row in enumerate(rows):
        position = index / max(1, len(rows)-1)
        brightness = .38 + .22 * abs(2*position-1)
        output.append(margin + blend(accents[0], accents[1], position, brightness)
                      + '║' + reset + row
                      + blend(accents[2], accents[1], position, brightness) + '║' + reset)
    output.append(rail('╚', '╝'))
    return output


def space_bark_shading(canvas, seed):
    """Use isolated shaded accents; fine grain keeps the limb body intact."""
    phase = random.Random(f'{seed}:shade-spacing').randrange(4)
    for y,row in enumerate(canvas):
        for x,(glyph,ink) in enumerate(row):
            if ink == 'bark' and glyph in '░▒▓' and (x+2*y+phase)%4:
                row[x] = ('·', ink)


@functools.lru_cache(maxsize=64)
def blossom_sites(seed):
    """Only some specimens bloom; sites remain fixed throughout growth."""
    rng = random.Random(f'{seed}:blossoms')
    if rng.random() >= .4:
        return ()
    candidates = sorted({(x,y) for x,y,born,glyph,ink in natural_specimen(seed,30)
                         if ink.startswith('leaf') and glyph in '●◆' and born <= 31
                         and 0 <= x < 57 and 0 <= y < 19})
    rng.shuffle(candidates)
    count = rng.randint(2,4)
    chosen = []
    for x,y in candidates:
        if all(max(abs(x-px),abs(y-py)) >= 3 for px,py,born in chosen):
            chosen.append((x,y,rng.uniform(21,26)))
        if len(chosen) == count:
            break
    return tuple(chosen)


def add_blossoms(canvas, seed, days):
    for x,y,born in blossom_sites(seed):
        if days >= born and canvas[y][x][1].startswith('leaf'):
            canvas[y][x] = ('✧' if days < born+1 else '✿', 'blossom')


def render(days, seed, color=True, columns=80, accents=None, style='informal',
           fixed_height=False, pot_seed=None):
    width, height = 57, 24
    canvas = [[(' ', '') for _ in range(width)] for _ in range(height)]
    # Growth starts with a rooted sapling; cells remain as new growth arrives.
    plan = specimen(seed, days, style)
    if style == 'informal':
        plan += juvenile_foliage(days, seed)
    # Leaves cover the upper wood while the exposed lower stem keeps its contour.
    wood = [cell for cell in plan if not cell[4].startswith('leaf')]
    leaves = [cell for cell in plan if cell[4].startswith('leaf')]
    for x, y, born, glyph, ink in wood + stem(days, seed, style) + leaves:
        if born <= days + 1 and 0 <= x < width and 0 <= y < 19:
            canvas[y][x] = (glyph, ink)
    if style == 'informal':
        cover_crown_wood(canvas)
        space_bark_shading(canvas, seed)
        add_blossoms(canvas, seed, days)
    for y, row in enumerate(pot_rows(seed if pot_seed is None else pot_seed), 19):
        for x, char in enumerate(row, 16):
            ink = 'pot'
            if y in (20, 21) and char not in ' ╲╱':
                ink = 'pot_inlay' if y == 20 or abs(x - 27) <= 2 else 'pot_shadow'
            canvas[y][x] = (char, ink)
    occupied = [y for y, row in enumerate(canvas) if any(c != ' ' for c, _ in row)]
    palette = {'wood': '\033[38;2;174;132;91m', 'leaf': '\033[38;2;133;180;112m',
               'pot': '\033[38;2;135;155;166m', 'bark': '\033[38;2;126;91;62m',
               'woodlight': '\033[38;2;198;156;106m', '': '\033[0m'}
    if style == 'informal':
        palette.update(wood='\033[38;2;185;158;119m', bark='\033[38;2;151;135;112m',
                       woodlight='\033[38;2;214;195;155m')
    palette['shoot'] = palette['wood']
    accents = accents if valid_palette(accents) else wallpaper_palette()
    bloom_rgb = [round(int(accents[2][k:k+2],16)*.8+255*.2) for k in (1,3,5)]
    palette['blossom'] = '\033[38;2;{};{};{}m'.format(*bloom_rgb)
    for name, accent, brightness in (('pot', accents[1], .85),
                                    ('pot_inlay', accents[0], .88),
                                    ('pot_shadow', accents[1], .55)):
        rgb = [round(int(accent[k:k + 2], 16) * brightness) for k in (1, 3, 5)]
        palette[name] = '\033[38;2;{};{};{}m'.format(*rgb)
    for i, accent in enumerate(accents):
        rgb_leaf = [int(accent[k:k + 2], 16) for k in (1, 3, 5)]
        # Short petioles fade from warm wood into the leaf's saved accent.
        for name, blend in (('mid', .35), ('tip', .7)):
            rgb = [round(wood * (1 - blend) + leaf * blend)
                   for wood, leaf in zip((185, 158, 119), rgb_leaf)]
            palette[f'shoot_{name}{i}'] = '\033[38;2;{};{};{}m'.format(*rgb)
        for j, brightness in enumerate((.75, .95, 1.12)):
            rgb = [min(255, round(int(accent[k:k + 2], 16) * brightness)) for k in (1, 3, 5)]
            palette[f'leaf{i * 3 + j}'] = '\033[38;2;{};{};{}m'.format(*rgb)
    output = []
    visible = canvas if fixed_height else canvas[min(occupied):max(occupied) + 1]
    for row in visible:
        parts, previous = [], None
        for glyph, ink in row:
            if color and ink != previous:
                parts.append(palette[ink])
            parts.append(glyph)
            previous = ink
        output.append(''.join(parts) + ('\033[0m' if color else ''))
    return '\n'.join(frame_rows(output, columns, accents, color)) + '\n'


def animate_growth(seed, accents, duration=2.5, style='informal'):
    """Play a bounded, skippable greeting and leave its final tree in scrollback."""
    import select
    import signal
    import termios
    import tty

    columns, rows = shutil.get_terminal_size()
    pot_seed = random.SystemRandom().randrange(2**63)
    def picture(day, fixed=False):
        return render(day, seed, True, shutil.get_terminal_size().columns,
                      accents, style, fixed_height=fixed, pot_seed=pot_seed)
    if rows < 28 or os.environ.get('REDUCE_MOTION') == '1':
        print(picture(30), end='')
        return
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    def stop(signum, frame):
        raise KeyboardInterrupt
    old_term = signal.signal(signal.SIGTERM, stop)
    reserved = False
    try:
        tty.setcbreak(fd)
        sys.stdout.write('\n' * 26 + '\033[?25l')
        reserved = True
        began = time.monotonic()
        while True:
            current_columns, current_rows = shutil.get_terminal_size()
            if current_columns < 59 or current_rows < 28:
                break
            elapsed = time.monotonic() - began
            day = min(30, elapsed / duration * 30)
            sys.stdout.write('\033[?2026h\033[26A\r' + picture(day, True) + '\033[?2026l')
            sys.stdout.flush()
            if day >= 30:
                break
            if select.select([fd], [], [], max(0, min(1/30, duration-elapsed)))[0]:
                os.read(fd, 1)
                break
    except KeyboardInterrupt:
        pass
    finally:
        try:
            current_columns, current_rows = shutil.get_terminal_size()
            if reserved and current_columns >= 59:
                if current_rows >= 28:
                    sys.stdout.write('\033[?2026h\033[26A\r' + picture(30, True) + '\033[?2026l')
                else:
                    sys.stdout.write('\n' + picture(30))
            sys.stdout.write('\033[0m\033[?25h\033[?2026l')
            sys.stdout.flush()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, previous)
            signal.signal(signal.SIGTERM, old_term)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--preview', type=float, metavar='DAYS', help='preview an age without changing saved growth')
    parser.add_argument('--seed', type=int, help='specimen for previews (default: saved tree, or 42)')
    parser.add_argument('--style', choices=('informal', 'natural', 'slant', 'semi-cascade'), default='informal',
                        help='trunk style; informal matches the tapered S-shaped reference')
    parser.add_argument('--plain', action='store_true', help='disable colors')
    parser.add_argument('--animate', action='store_true', help='Play full growth without changing saved age; any key skips')
    parser.add_argument('--duration', type=float, default=2.5, help='Time-lapse duration in seconds (default: 2.5)')
    args = parser.parse_args()
    if not math.isfinite(args.duration) or args.duration <= 0:
        parser.error('--duration must be a positive finite number')
    columns = shutil.get_terminal_size().columns
    if args.preview is None and (not sys.stdout.isatty() or columns < 59 or os.environ.get('TERM') == 'dumb'):
        return
    if args.animate:
        if not sys.stdout.isatty() or not sys.stdin.isatty():
            return
        # New terminals get a fresh specimen; --seed keeps previews repeatable.
        seed = args.seed if args.seed is not None else random.SystemRandom().randrange(2**63)
        accents = wallpaper_palette()
        if args.plain:
            print(render(30, seed, False, columns, accents, args.style), end='')
        else:
            animate_growth(seed, accents, args.duration, args.style)
        return
    try:
        days, seed, accents = age() if args.preview is None else (max(0, args.preview), *preview_identity(args.seed))
        print(render(days, seed, not args.plain and sys.stdout.isatty(), columns,
                     wallpaper_palette(), args.style), end='')
    except (OSError, ValueError, TypeError, AttributeError):
        return


if __name__ == '__main__':
    main()
