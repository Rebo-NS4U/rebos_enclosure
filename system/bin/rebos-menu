#!/usr/bin/env python3
"""Read choices on stdin and return the shell's selection on stdout."""
import argparse
import json
import os
import socket
import sys

parser = argparse.ArgumentParser()
parser.add_argument("--dmenu", action="store_true")
parser.add_argument("--prompt", default="Select")
parser.add_argument("--placeholder", default="Search…")
args = parser.parse_args()
try:
    with socket.socket(socket.AF_UNIX) as connection:
        connection.connect(os.path.join(os.environ["XDG_RUNTIME_DIR"], "rebos-shell-menu.sock"))
        connection.sendall((json.dumps({"title": args.prompt, "placeholder": args.placeholder,
                                       "lines": sys.stdin.read().splitlines()}) + "\n").encode())
        response = json.loads(connection.makefile().readline())
        if response.get("selection") is None:
            sys.exit(1)
        print(response["selection"])
except (OSError, ValueError, KeyError):
    print("Quickshell selection interface unavailable", file=sys.stderr)
    sys.exit(1)
