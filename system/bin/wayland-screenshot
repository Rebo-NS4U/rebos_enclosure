#!/usr/bin/env bash
set -euo pipefail

# Open the on-demand selector and editor with the shared shell theme.
MODE="${1:-area}"
case "$MODE" in
    area|edit|screen|output|window)
        [ "$MODE" != output ] || MODE=screen
        export ENCLOSURE_SCREENSHOT_MODE="$MODE"
        exec qs -n -p "$HOME/.config/quickshell/screenshot.qml"
        ;;
    ocr) ;; # Preserve the existing text extraction shortcut.
    *) printf 'Usage: %s [area|screen|window|edit|output|ocr]\n' "$0" >&2; exit 2 ;;
esac

TEMP=$(mktemp --suffix=.png)
trap 'rm -f "$TEMP"' EXIT
geometry=$(slurp) || exit 0
grim -g "$geometry" "$TEMP"
tesseract -l eng "$TEMP" stdout | wl-copy
notify-send "Text copied" "OCR result is on the clipboard."
