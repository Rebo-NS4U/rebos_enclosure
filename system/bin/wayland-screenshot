#!/usr/bin/env bash
set -euo pipefail

# Reuse the warm editor; start it lazily if login prewarming has not run.
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/screenshot.qml"
MODE="${1:-area}"
case "$MODE" in
    --warm) exec qs -d -n -p "$CONFIG" ;;
    area|edit|screen|output|window)
        [ "$MODE" != output ] || MODE=screen
        if qs ipc -p "$CONFIG" call screenshot capture "$MODE" 2>/dev/null; then
            exit 0
        fi
        qs -d -n -p "$CONFIG"
        # IPC registers before startup finishes. Retry only while it is unavailable.
        for ((attempt=0; attempt<100; attempt++)); do
            if qs ipc -p "$CONFIG" call screenshot capture "$MODE" 2>/dev/null; then
                exit 0
            fi
            sleep 0.05
        done
        notify-send "Screenshot failed" "The screenshot editor did not become ready."
        exit 1
        ;;
    ocr) ;; # Preserve the existing text extraction shortcut.
    *) printf 'Usage: %s [area|screen|window|edit|output|ocr|--warm]\n' "$0" >&2; exit 2 ;;
esac

TEMP=$(mktemp --suffix=.png)
trap 'rm -f "$TEMP"' EXIT
geometry=$(slurp) || exit 0
grim -g "$geometry" "$TEMP"
tesseract -l eng "$TEMP" stdout | wl-copy
notify-send "Text copied" "OCR result is on the clipboard."
