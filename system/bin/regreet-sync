#!/usr/bin/python3
"""Publish the current desktop wallpaper and effective palette for ReGreet."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

from PIL import Image, ImageOps

HOME = Path.home()
CACHE = HOME / '.cache/rebos_shell'
TARGET = Path('/var/lib/rebos-greeter/theme')


def atomic_write(path, data):
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            os.fchmod(stream.fileno(), 0o644)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    state = json.loads((CACHE / 'wallpapers.json').read_text())
    wallpaper = Path(state['currentWall'])
    palette = json.loads((CACHE / 'effective-palette.json').read_text())
    template = (HOME / '.config/regreet-sync/regreet.css.in').read_text()

    # The effective palette already contains the shared surface hierarchy.
    # Read geometry separately so font/corner changes invalidate the CSS stamp.
    try:
        theme = json.loads((HOME / '.config/enclosure/shell/config/theme.json').read_text())
    except (OSError, ValueError):
        theme = {}
    def number(key, default, low, high):
        try:
            return max(low, min(high, int(theme.get(key, default))))
        except (TypeError, ValueError):
            return default
    font = str(theme.get('font', 'JetBrains Mono'))
    if not re.fullmatch(r'[\w .+-]{1,80}', font):
        font = 'JetBrains Mono'
    radius = number('roundness', 16, 0, 40)
    try:
        opacity = max(0, min(1, float(palette.get('opacity', 1))))
    except (TypeError, ValueError):
        opacity = 1
    metrics = {'font': font, 'fontSize': str(number('fontSize', 14, 8, 32)),
               'radius': str(radius), 'innerRadius': str(max(0, radius - 6)),
               'opacity': str(opacity)}

    def token(match):
        key = match[1]
        if key in metrics:
            return metrics[key]
        value = palette[key]
        if not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
            raise ValueError('Invalid palette color: ' + key)
        return value

    css = re.sub(r'\{\{(\w+)\}\}', token, template).encode()
    info = wallpaper.stat()
    image_signature = [str(wallpaper), info.st_mtime_ns, info.st_size]
    signature = {'image': image_signature, 'css': hashlib.sha256(css).hexdigest()}
    stamp = CACHE / 'regreet-sync.json'
    previous = json.loads(stamp.read_text()) if stamp.exists() else {}
    if previous.get('image') != image_signature or not (TARGET / 'background.png').exists():
        if wallpaper.suffix.lower() in {'.mp4', '.webm', '.mkv', '.mov', '.avi', '.m4v'}:
            frame = subprocess.run(['ffmpeg', '-v', 'error', '-i', str(wallpaper),
                                    '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'],
                                   check=True, capture_output=True, timeout=60).stdout
            source = io.BytesIO(frame)
        else:
            source = wallpaper
        with Image.open(source) as image:
            image = ImageOps.exif_transpose(image).convert('RGB')
            image.thumbnail((3840, 2160))
            output = io.BytesIO()
            image.save(output, format='PNG')
        atomic_write(TARGET / 'background.png', output.getvalue())
    if previous.get('css') != signature['css'] or not (TARGET / 'regreet.css').exists():
        atomic_write(TARGET / 'regreet.css', css)
    if previous != signature:
        atomic_write(stamp, json.dumps(signature).encode())
        print('ReGreet wallpaper and colors synchronized', flush=True)


if __name__ == '__main__':
    main()
