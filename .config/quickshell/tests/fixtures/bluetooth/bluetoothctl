#!/usr/bin/env python3
"""Synthetic BlueZ CLI for the real QML service regression."""
import json
import fcntl
import os
from pathlib import Path
import sys
import time

state_path = Path(os.environ["BT_TEST_STATE"])
args = sys.argv[1:]
if args[:1] == ["--timeout"]:
    time.sleep(0.9)
    sys.exit(0)
if args[:1] == ["--agent"]:
    args = args[2:]
lock = state_path.with_suffix(".lock").open("w")
fcntl.flock(lock, fcntl.LOCK_EX)
state = json.loads(state_path.read_text())
command = args[0]
devices = state["devices"]
if command == "show":
    print("Powered: " + ("yes" if state["powered"] else "no"))
elif command == "devices":
    for address, device in devices.items():
        if len(args) == 1 or device["connected"]:
            print("Device", address, device["name"])
elif command == "info":
    device = devices[args[1]]
    for key in ("paired", "trusted", "connected"):
        print(key.title() + ": " + ("yes" if device[key] else "no"))
    print("Icon: audio-headset")
    print("Battery Percentage: 0x00 (0)")
else:
    if args[-1] == "FAIL":
        print("Failed to connect: test failure")
        sys.exit(1)
    if command == "power":
        time.sleep(0.12)
        state["powered"] = args[1] == "on"
    elif command == "remove":
        del devices[args[1]]
    else:
        key = {"pair": "paired", "trust": "trusted", "connect": "connected", "disconnect": "connected"}[command]
        devices[args[1]][key] = command != "disconnect"
    state_path.write_text(json.dumps(state))
